2965.5"/><mxPoint x="882.0" y="3409.5"/></Array></mxGeometry></mxCell><mxCell id="bridge.c18" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="bridge.st5" target="bridge.out7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890.0" y="3283.0"/><mxPoint x="890.0" y="3484.0"/></Array></mxGeometry></mxCell><mxCell id="bridge.c19" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1e9e3e;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="bridge.st4" target="bridge.out8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="866.0" y="3195.5"/><mxPoint x="866.0" y="3566.0"/></Array></mxGeometry></mxCell><mxCell id="task" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7785;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1372.0" y="2834.0" width="1052.0" height="1681.0" as="geometry"/></mxCell><mxCell id="task.head" value="&lt;b style=&quot;font-size:16px&quot;&gt;task — 작업 관리자 + 작업 판단 + 검사 묶음&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e2efda;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=72;" vertex="1" parent="1"><mxGeometry x="1372.0" y="2834.0" width="1052.0" height="50.0" as="geometry"/></mxCell><mxCell id="task.badge" value="&lt;b&gt;노드&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1382.0" y="2846.0" width="52.0" height="24.0" as="geometry"/></mxCell><mxCell id="task.meta" value="비전 · 패키지 d2_task&lt;br&gt;&lt;b&gt;&lt;span style=&quot;color:#5566b5&quot;&gt;돌리는 곳: 호스트&lt;/span&gt;&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2064.0" y="2838.0" width="350.0" height="42.0" as="geometry"/></mxCell><mxCell id="task.col10" value="&lt;b&gt;입력 — 받는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1382.0" y="2888.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="task.col266" value="&lt;b&gt;처리 — 하는 일(번호 순)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1638.0" y="2888.0" width="520.0" height="22.0" as="geometry"/></mxCell><mxCell id="task.col832" value="&lt;b&gt;출력 — 내보내는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="2204.0" y="2888.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="task.grp0" value="&lt;b&gt;클래스 TaskManager — 상태표(조립 · 공급 · 스캔 · 정지 · 시간 제한)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="1632.0" y="2914.0" width="532.0" height="876.0" as="geometry"/></mxCell><mxCell id="task.grp1" value="&lt;b&gt;클래스 TaskPlanner · PickRanker · ScatterFlow — 작업 판단 · 고르기&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="1632.0" y="3798.0" width="532.0" height="281.0" as="geometry"/></mxCell><mxCell id="task.grp2" value="&lt;b&gt;클래스 DesignChecker · TemplateChecker — 검사 1 ~ 21번 + 변환기 ① (ROS 없음)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="1632.0" y="4087.0" width="532.0" height="311.0" as="geometry"/></mxCell><mxCell id="task.grp3" value="&lt;b&gt;클래스 RunLogger · BuildSender — 기록 · 결과 보내기&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="1632.0" y="4406.0" width="532.0" height="91.0" as="geometry"/></mxCell><mxCell id="task.in0" value="&lt;b&gt;/d2/hmi/command (서비스 받음)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;select_design · start · scan · cancel · [계속] = start — 브리지가 부름&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1382.0" y="2914.0" width="210.0" height="71.0" as="geometry"/></mxCell><mxCell id="task.in1" value="&lt;b&gt;/d2/hmi/command — 정지 잠금 때(W183 #157)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;STOPPED에서 cancel([초기화] — 기록 닫기 → [정리 끝]) · gripper_open([그리퍼 열기]) (E-98). 여는 중 BUSY = select_design · start · scan · gripper_open만(cancel · 정지 · resume은 받음, E-111 A2)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1382.0" y="2995.0" width="210.0" height="142.0" as="geometry"/></mxCell><mxCell id="task.in2" value="&lt;b&gt;/d2/hmi/intent (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;음성 select_design · start · cancel만 받음(화면 흐름은 안 씀 · request_design 무시)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1382.0" y="3147.0" width="210.0" height="71.0" as="geometry"/></mxCell><mxCell id="task.in3" value="&lt;b&gt;/d2/safety/state (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;멈춤 · 잠금&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1382.0" y="3228.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="task.in4" value="&lt;b&gt;중간 보고 · 결과 ← pick_place&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;step · 성공 · 실패 코드&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1382.0" y="3281.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="task.in5" value="&lt;b&gt;check_progress 응답 ← wrist_block&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;부품마다 상태 · 높이 · 오차&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1382.0" y="3334.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="task.in6" value="&lt;b&gt;find_blocks 응답 ← wrist_block&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;흩어진 블록마다 자리 · yaw · 자세 · 틈 · 겹침 · 기울어짐 / assembly — 놓은 블록 1개 · rejected · measured_stamp&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1382.0" y="3402.0" width="210.0" height="100.0" as="geometry"/></mxCell><mxCell id="task.in7" value="&lt;b&gt;scan_capture · scan_infer 응답 ← wrist_block&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;blocks/2 · 추정 수(inferred_count) · nearest_base · 사진 · 점군 경로 — 신뢰도 미달이면 ok:false SCAN_FAILED&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1382.0" y="3512.0" width="210.0" height="114.0" as="geometry"/></mxCell><mxCell id="task.in8" value="&lt;b&gt;get_design · save_build 응답 ← bridge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;design/4.0 — recipe/4.0 · placements/4.0 · parts / ok · retry(false = 영구 거절 → rejected/)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1382.0" y="3636.0" width="210.0" height="100.0" as="geometry"/></mxCell><mxCell id="task.in9" value="&lt;b&gt;/d2/task/check_design (서비스 받음)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;parts/4.0 + base_recipe (+ 스캔 저장만 made_by &quot;scan&quot;) — 브리지가 부름&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1382.0" y="3746.0" width="210.0" height="86.0" as="geometry"/></mxCell><mxCell id="task.in10" value="&lt;b&gt;/d2/gripper/state (토픽) · command 응답 ← gripper&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;상태: 시작 점검 빈 손 · 다시 시작 때 쥔 블록 · 집기 실패 뒤 잡힘 / 응답: gripper_open success · grasped · width_m · reason&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1382.0" y="3842.0" width="210.0" height="100.0" as="geometry"/></mxCell><mxCell id="task.in11" value="&lt;b&gt;/d2/hmi/alive (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;웹 연결 신호 — 3초 끊기면 WAIT_HMI&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1382.0" y="3952.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="task.in12" value="&lt;b&gt;robot.yaml · 노드 파라미터 ← bringup config&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;timeout.* · scan.poses · supply_mode · scatter.* · check.margin_mm · spare_spots / w144_* (전체 키 IRD 9장)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1382.0" y="4005.0" width="210.0" height="100.0" as="geometry"/></mxCell><mxCell id="task.out0" value="&lt;b&gt;/d2/hmi/get_design (서비스)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;design_id → design/4.0 (브리지가 응답함)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2204.0" y="2914.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="task.out1" value="&lt;b&gt;/d2/motion/move_to (서비스)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;observe(시작 점검 · VERIFY) · observe_supply · observe_spare · home · 스캔 5자세 · speed_ratio&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2204.0" y="2981.0" width="210.0" height="85.0" as="geometry"/></mxCell><mxCell id="task.out2" value="&lt;b&gt;/d2/vision/check_progress (서비스)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;design_id · run_id · part_ids&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2204.0" y="3076.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="task.out3" value="&lt;b&gt;/d2/vision/find_blocks (서비스)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;run_id · height_map · area spare → 공급 · 받침 블록 목록 · area assembly + design_id · part_id → 놓은 블록 다시 재기(A4 — 재는 방법 기본 마스크)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2204.0" y="3144.0" width="210.0" height="114.0" as="geometry"/></mxCell><mxCell id="task.out4" value="&lt;b&gt;/d2/motion/pick_place (액션)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;목표 1개 — part_id · grasp(레시피 6개 + TILT · TIP · STANDUP_*) · open_width_m · obstacles (전체 칸 IRD 4.3)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2204.0" y="3268.0" width="210.0" height="85.0" as="geometry"/></mxCell><mxCell id="task.out5" value="&lt;b&gt;/d2/vision/scan_capture · scan_infer (서비스)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;자세마다 촬영 · 추론&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2204.0" y="3363.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="task.out6" value="&lt;b&gt;/d2/safety/stop (서비스)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;TIMEOUT · Ctrl+C(CTRL_C) · 예외(빈 reason = STOP_TASK) 때 먼저 세움 (source task)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2204.0" y="3431.0" width="210.0" height="71.0" as="geometry"/></mxCell><mxCell id="task.out7" value="&lt;b&gt;/d2/task/state (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;state/2 — 상태 · run_id · message_id(supply_empty · stop_pending · done …) (전체 칸 IRD 6장 · message_id 2장)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2204.0" y="3512.0" width="210.0" height="85.0" as="geometry"/></mxCell><mxCell id="task.out8" value="&lt;b&gt;/d2/task/progress (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;progress/2.0 → 장면 관리 · 브리지 → 화면 (빈 진행표 = 장면 비움)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2204.0" y="3607.0" width="210.0" height="71.0" as="geometry"/></mxCell><mxCell id="task.out9" value="&lt;b&gt;/d2/task/scan_result (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;scan_result/2.0 → 브리지 → 화면 비교&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2204.0" y="3688.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="task.out10" value="&lt;b&gt;check_design 응답&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;check_result/3.0 — 통과 · errors[kind] · 레시피 · 조립 방법 · feasible_order(W201)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2204.0" y="3755.0" width="210.0" height="71.0" as="geometry"/></mxCell><mxCell id="task.out11" value="&lt;b&gt;/d2/hmi/save_build (서비스)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;build/2 → 브리지 → 웹&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2204.0" y="3836.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="task.out12" value="&lt;b&gt;/d2/motion/scene/attach (서비스)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;출발 때 남은 쥔 상자 떼기(part_id 빈 값 · attach false)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2204.0" y="3889.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="task.out13" value="&lt;b&gt;(선택) W144 기록 — w144_record&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;기본 끔 · 켜면 VERIFY 통과마다 observe 촬영 + rosbag → ~/d2_data/runs/w144_* ZIP&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2204.0" y="3971.0" width="210.0" height="86.0" as="geometry"/></mxCell><mxCell id="task.out14" value="&lt;b&gt;/d2/gripper/command (서비스)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;gripper_open: 0.0865 m · 10 N (정지 잠금 때만, E-98 · #157)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2204.0" y="4067.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="task.out15" value="&lt;b&gt;command 응답 → bridge (ROS)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;success · reason(BUSY · STOPPED · TIMEOUT · 그 밖 거절 코드 IRD 7장)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2204.0" y="4134.0" width="210.0" height="71.0" as="geometry"/></mxCell><mxCell id="task.out16" value="&lt;b&gt;/d2/task/state pick 칸 → wrist_block (#183)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;state/2 pick {image_seq · index · ranks · reason} — 고른 블록 · 우선순위(그 find_blocks 응답 차례, 1부터) · PickRanker 선택 이유. 그 블록을 놓을 때까지 매 state/2에 실림(retained) · DONE · 취소 · 새 출발이면 뺌&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2204.0" y="4215.0" width="210.0" height="142.0" as="geometry"/></mxCell><mxCell id="task.st0" value="① 명령: 설계 선택(get_design으로 design/4.0) · 출발 · 스캔 · [계속] · 취소. 4초(timeout.command_s) 안에 확정 못 하면 실행 안 함 → TIMEOUT" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="2938.0" width="520.0" height="40.0" as="geometry"/></mxCell><mxCell id="task.st1" value="② 시작 점검(서버 move_to · check_progress · pick_place · safety/stop · find_blocks가 떠 있음 · 웹 연결 신호 · 정지 노드 신호 + 안 잠김 · 그리퍼 신호 + 빈 손) → 관측 자세 move_to(observe) · (선택) W144 기록 시작" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="2988.0" width="520.0" height="55.0" as="geometry"/></mxCell><mxCell id="task.st2" value="③ 확인 요청 check_progress(design_id · run_id · part_ids) → 응답을 TaskPlanner에" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="3053.0" width="520.0" height="40.0" as="geometry"/></mxCell><mxCell id="task.st3" value="④ 공급 = 흩뿌림 + 받침 경유(supply_mode scatter · via_spare — 공급 칸 없앰, E-103 · W188 #152): 출발 때 남은 쥔 상자 떼기(scene/attach) · 홈 → observe_supply → find_blocks(height_map) → 고른 블록을 받침(spare_spots 첫 자리)에 놓음 → observe_spare → find_blocks(area spare)로 재기 → 세운 블록은 TIP 눕히기 · 맞추기(반대 폭으로 집어 받침 가운데에 옮겨 놓고 다시 재기 — 2 mm 넘으면 블록당 2번, #170) → 세움 · 옆세움 레시피면 맞춘 뒤 STANDUP_HIGH · STANDUP_SIDE로 세우고 다시 잼(세우기는 조립 아님, #156 E-110) → 레시피 잡기(레시피 자세로 선 블록은 바로)로 다시 집어 조립 · 팔이 움직인 실패 블록당 3번 · find_blocks 10초 + 다시 2번 · 막히면 WAIT_SUPPLY(supply_empty · tilted_block · no_match_block) → [계속]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="3103.0" width="520.0" height="160.0" as="geometry"/></mxCell><mxCell id="task.st4" value="⑤ 부품마다 pick_place 결과 → VERIFY(check_progress) → 다음 부품 → 끝나면 DONE. 그리퍼 응답 없음 · 피드백 없음 = ERROR(E-74). A4 놓은 블록 다시 재기 · 다시 집기(챌린지 B — 한석형 · 측정 민범진, 다시 집기 기본 켬 · 재기 포함 — 10/15 #194 · E-119 ㉔): VERIFY 통과 블록을 find_blocks area assembly(design_id · part_id)로 다시 재서 기록(w144_measure) → 축별 2 mm 이상(반올림 전)이면 잰 자리에서 집어 처음 목표에 다시 놓고 다시 잼(w144_regrasp — 블록당 2번, 다 써도 남으면 남은 오차 기록 · 다음 블록) · VERIFY 어긋남(받침 경유 place_dz_m 5 mm)은 ERROR 아니라 WAIT_SUPPLY(no_match_block) — 사람이 바로 놓고 [계속]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="3273.0" width="520.0" height="145.0" as="geometry"/></mxCell><mxCell id="task.st5" value="⑤-1 A4 못 잰 경우(측정 거절 rejected · 측정 시각이 요청 · 응답 사이 밖 · 기울어짐 · 자세 다름)는 다시 집지 않고 사람도 안 부름 — 원인만 기록하고 다음 블록(#182, E-119 ⑩ · 9차). 다시 집기 길을 못 풀면(움직이기 전) 사람 확인 WAIT_SUPPLY → [계속]. 모서리 판정(w144_corner_judge, #190 — 기본 꺼짐)을 켜면 Z 문제 · 기울어짐은 사람 수정 대기(알림 placed_check). 다시 재기 10초 초과 = 정지 요청 → ERROR" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="3428.0" width="520.0" height="100.0" as="geometry"/></mxCell><mxCell id="task.st6" value="⑥ 스캔(IDLE · DONE · SCAN_REVIEW에서 — DONE이면 끝난 조립 기록 그대로 새 run_id): robot.yaml scan.poses 5자세(observe · 뒤 왼쪽 · 앞 · 앞 오른쪽 · 옆, W186)마다 move_to → scan_capture → scan_infer → scan_result 방송 → SCAN_REVIEW(저장된 설계 select_design → READY · scan = 다시 · cancel → IDLE). 응답이 ok:false면 &#x27;스캔 실패&#x27; · &#x27;다시 스캔하세요&#x27; + 이유 → ERROR(W182)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="3538.0" width="520.0" height="100.0" as="geometry"/></mxCell><mxCell id="task.st7" value="⑦ 멈춤이면 STOPPED → 다시 시작 → 쥔 블록 확인 → 진행 확인부터(첫 move_to 0.4배 = 0.2 — recover.speed_ratio). 웹 끊김 3초면 지금 부품까지 놓고 WAIT_HMI. 시간 제한(서비스 3 · move_to 45 · pick_place 120초)을 넘으면 safety/stop(source task) 먼저 · 시간 초과 정지 확인 전 ERROR = message_id stop_pending([다시 시작] 끔, E-117) · 잠금 중 cancel([초기화]) · gripper_open([그리퍼 열기]) 받음(W183 — E-98) · 쥔 채면 &#x27;[정지] → [그리퍼 열기] → [다시 시작]&#x27; 안내 · ERROR 도 [다시 시작] → RECOVER · [취소] → IDLE(기록 ERROR 로 닫음)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="3648.0" width="520.0" height="130.0" as="geometry"/></mxCell><mxCell id="task.st8" value="⑧ 관측 ↔ 레시피(part_id = &lt;설계 ID&gt;_&lt;역할&gt;_&lt;그룹 3자리&gt;_&lt;부품 2자리&gt;) → 진행표 progress/2.0(있음 · 없음 · 높이 · 오차) → 방송 · [조립] 출발 · [초기화] → [정리 끝] 때는 빈 진행표(장면 비움 — DONE · 그냥 정지 → 다시 시작 · [취소]는 그대로, E-120)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="3822.0" width="520.0" height="70.0" as="geometry"/></mxCell><mxCell id="task.st9" value="⑨ 다음 부품 = placements sequence의 첫 미배치(받침 있음) · 설계 좌표 + 조립 원점 → 로봇 좌표(motion_math)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="3902.0" width="520.0" height="40.0" as="geometry"/></mxCell><mxCell id="task.st10" value="⑩ PickRanker(pick_rank): 덮이지 않은 블록의 잡기 후보(눕힘 · 옆세움 · 섬 · 기울면 TILT)를 손가락 자리 · 높이 지도로 거른 뒤 높은 곳에서 아래로 — 눕힌 블록 → 옆으로 선 · 선 블록 → 큰 옮김(잡을 게 없을 때만), 묶음 안에서 높은 층부터(기울어진 블록은 실제 높이 · 1.5층 아래면 1층) → 같은 높이면 칸 순서(덮은 블록 치우기 → 곧게 → 틀기 → 기울여 집기) · 열림 · 틈 → 맨 앞 후보. 세움 · 옆세움 레시피 블록은 받침에서 세운 뒤 집음(④ — standup_taught 없으면 STAND_NOT_READY → ERROR)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="3952.0" width="520.0" height="115.0" as="geometry"/></mxCell><mxCell id="task.st11" value="⑪ 검사 1 ~ 20번: 형식(블록 수 ≤ 54 — 넘으면 OUT_OF_SCOPE · kind scope) · 파고듦 · 받침 · 안정성(무게중심 여유 7 mm, 쌓는 도중) · 잡을 면(손가락 자리 — 잡기 틈 · 막힌 칸은 같은 검사 하나) · [⑫-1] · 작업영역" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="4111.0" width="520.0" height="55.0" as="geometry"/></mxCell><mxCell id="task.st12" value="⑫ 21번 Template 검사(base_recipe의 template.composition — 구성 형태 · 범위 · 관계) · 스캔 설계(made_by &quot;scan&quot;)는 건너뜀(E-106) → 통과면 변환기 ①(parts → recipe/4.0 + placements/4.0) → 답. reason = REQUEST_INVALID(웹 요청 오류 · kind 없음 · 다시 안 만듦) / CHECK_FAILED · OUT_OF_SCOPE / TEMPLATE_SHAPE · TEMPLATE_RANGE — errors[kind] = position · ai_fields · template · scope" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="4176.0" width="520.0" height="100.0" as="geometry"/></mxCell><mxCell id="task.st13" value="⑫-1 로봇 조립 가능 검사(W201 — 한세교 계산 assembly_feasibility · PM 연결, E-121 · 9차, 검사 순서는 잡기 틈 뒤 · 작업영역 앞): R0 층 방향 · R1 받침 순서 · R2 닿는 면 15 mm · R3 안정성 · R5 손가락 자리로 블록을 하나씩 더해 끝까지 지을 순서를 찾음 → 어떤 순서로도 못 지으면 position(&#x27;로봇 조립 불가&#x27;) · AI 순서만 안 되면 ai_fields + 찾은 순서 → AI가 다시 씀 · 응답에 새 칸 feasible_order(스캔은 격자 2.5 · 5 mm 맞춤 뒤)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="4286.0" width="520.0" height="100.0" as="geometry"/></mxCell><mxCell id="task.st14" value="⑬ run_id CSV(log_dir — A4 a4_measure · a4_regrasp 줄 포함) · build/2 요약 → BuildSender가 save_build(브리지 → 웹). 못 보내면 pending_builds/에 두고 다시 · 영구 거절(retry false)은 rejected/로" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1638.0" y="4430.0" width="520.0" height="55.0" as="geometry"/></mxCell><mxCell id="task.c0" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1f4fd6;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exit