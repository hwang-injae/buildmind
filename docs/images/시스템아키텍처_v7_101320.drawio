8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="200.0" y="3062.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="bridge.in3" value="&lt;b&gt;MQTT get_design/res · save_build/res&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;웹의 응답&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="200.0" y="3130.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="bridge.in4" value="&lt;b&gt;/d2/task/state · progress · scan_result (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;작업 관리자&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="200.0" y="3198.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="bridge.in5" value="&lt;b&gt;/d2/safety/state · /d2/gripper/state (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;정지 노드 · 그리퍼&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="200.0" y="3266.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="bridge.in6" value="&lt;b&gt;/d2/vision/wrist_image (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;손목 검출 JPEG&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="200.0" y="3334.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="bridge.in7" value="&lt;b&gt;ROS 서비스 응답 ← task · safety_stop&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;command(task — success · reason) · stop · resume(safety_stop — success · message) · check_design(task — check_result/3.0)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="200.0" y="3387.0" width="210.0" height="114.0" as="geometry"/></mxCell><mxCell id="bridge.in8" value="&lt;b&gt;MQTT d2/web/alive&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;웹 연결 신호&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="200.0" y="3511.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="bridge.in9" value="&lt;b&gt;/d2/vision/scan_preview (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;스캔 중 점군 미리보기 kind capture(누적, wrist_block) · live(실시간, scan_live_preview) — JSON + cloud_path(E-82 A/B)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="200.0" y="3564.0" width="210.0" height="100.0" as="geometry"/></mxCell><mxCell id="bridge.out0" value="&lt;b&gt;/d2/hmi/command · /d2/safety/stop · resume · /d2/task/check_design (서비스 부름)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;ROS 호출&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="902.0" y="2914.0" width="210.0" height="88.0" as="geometry"/></mxCell><mxCell id="bridge.out1" value="&lt;b&gt;/d2/hmi/intent (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;음성 문장&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="902.0" y="3012.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="bridge.out2" value="&lt;b&gt;MQTT d2/hmi/get_design/req · save_build/req&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;웹에 물음&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="902.0" y="3065.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="bridge.out3" value="&lt;b&gt;get_design · save_build 응답 → task · wrist_block (ROS)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;design/4.0 / ok · retry(false = 영구 거절)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="902.0" y="3133.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="bridge.out4" value="&lt;b&gt;MQTT d2/task/state · progress · scan_result · d2/safety/state · d2/gripper/state&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;retained · payload 그대로&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="902.0" y="3215.0" width="210.0" height="88.0" as="geometry"/></mxCell><mxCell id="bridge.out5" value="&lt;b&gt;MQTT d2/vision/wrist_image · scan_image · scan_cloud&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;바이트 · retained 아님&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="902.0" y="3313.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="bridge.out6" value="&lt;b&gt;MQTT …/res&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;command · stop · resume · check_design 응답&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="902.0" y="3381.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="bridge.out7" value="&lt;b&gt;MQTT d2/bridge/alive · /d2/hmi/alive (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;1초 · LWT / 웹 연결 신호 → 작업 관리자&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="902.0" y="3448.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="bridge.out8" value="&lt;b&gt;MQTT d2/vision/scan_preview · scan_preview_cloud&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;JSON + PLY 바이트 — retained 아님&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="902.0" y="3530.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="bridge.st0" value="① …/req 받기 → ROS 서비스 호출(hmi/command · safety/stop · resume · task/check_design) → 응답을 …/res로 (req_id 짝 · 같은 req_id 한 번만)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="456.0" y="2938.0" width="400.0" height="55.0" as="geometry"/></mxCell><mxCell id="bridge.st1" value="② d2/hmi/intent → ROS 토픽 /d2/hmi/intent 그대로" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="456.0" y="3003.0" width="400.0" height="25.0" as="geometry"/></mxCell><mxCell id="bridge.st2" value="③ /d2/hmi/get_design · save_build 서비스 제공 → MQTT …/req → 웹 응답 …/res(5초) → ROS 응답" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="456.0" y="3038.0" width="400.0" height="40.0" as="geometry"/></mxCell><mxCell id="bridge.st3" value="④ 상태 토픽 5개 → MQTT retained(JSON 그대로) — 다시 붙으면 마지막 값을 다시 보냄" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="456.0" y="3088.0" width="400.0" height="40.0" as="geometry"/></mxCell><mxCell id="bridge.st4" value="⑤ 바이트: 손목 영상 JPEG(QoS 0) · scan_result가 오면 그 사진(≤ 500 KB) · 점군 PLY(≤ 2 MB) 파일을 같은 PC 디스크(&lt;scan_dir&gt;/&lt;run_id&gt;/, 기본 ~/d2_data/scan)에서 읽어 scan_image · scan_cloud로 · scan_preview JSON 바로 뒤에 그 PLY를 scan_preview_cloud로(capture QoS 1 · live QoS 0) · 다시 붙으면 마지막 스캔 사진 · 점군도 다시 보냄(retained 아니라서)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="456.0" y="3138.0" width="400.0" height="115.0" as="geometry"/></mxCell><mxCell id="bridge.st5" value="⑥ 연결 신호 d2/bridge/alive 1초 · LWT(alive false) · d2/web/alive → /d2/hmi/alive(끊김 판단은 task)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeCo