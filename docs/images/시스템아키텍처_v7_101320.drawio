000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="frontend.st4" target="frontend.out1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3686.0" y="1147.5"/><mxPoint x="3686.0" y="816.5"/></Array></mxGeometry></mxCell><mxCell id="backend" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7785;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="4184.0" y="606.0" width="1032.0" height="1243.0" as="geometry"/></mxCell><mxCell id="backend.head" value="&lt;b style=&quot;font-size:16px&quot;&gt;backend — API + AI 생성 + 저장소 (FastAPI :8000 · ROS 아님)&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fde9d9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=72;" vertex="1" parent="1"><mxGeometry x="4184.0" y="606.0" width="1032.0" height="50.0" as="geometry"/></mxCell><mxCell id="backend.badge" value="&lt;b&gt;노드&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="4194.0" y="618.0" width="52.0" height="24.0" as="geometry"/></mxCell><mxCell id="backend.meta" value="HMI · 패키지 web/backend&lt;br&gt;&lt;b&gt;&lt;span style=&quot;color:#1565c0&quot;&gt;돌리는 곳: 컨테이너 web&lt;/span&gt;&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="4856.0" y="610.0" width="350.0" height="42.0" as="geometry"/></mxCell><mxCell id="backend.col10" value="&lt;b&gt;입력 — 받는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="4194.0" y="660.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="backend.col266" value="&lt;b&gt;처리 — 하는 일(번호 순)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="4450.0" y="660.0" width="500.0" height="22.0" as="geometry"/></mxCell><mxCell id="backend.col812" value="&lt;b&gt;출력 — 내보내는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="4996.0" y="660.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="backend.grp0" value="&lt;b&gt;app.py(FastAPI) + 클래스 MqttClient — REST · /ws · 정적 서빙 · MQTT(req_id)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="4444.0" y="686.0" width="512.0" height="301.0" as="geometry"/></mxCell><mxCell id="backend.grp1" value="&lt;b&gt;클래스 DesignGenerator — LLM 부르는 한 곳 · 후보 3개 · 검사 · 다시 (ROS 없음)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="4444.0" y="995.0" width="512.0" height="386.0" as="geometry"/></mxCell><mxCell id="backend.grp2" value="&lt;b&gt;클래스 DesignStore · PgDesignStore — 저장 한 곳(PostgreSQL · 비면 JSON)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="4444.0" y="1389.0" width="512.0" height="201.0" as="geometry"/></mxCell><mxCell id="backend.in0" value="&lt;b&gt;REST 요청 ← frontend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;명령 /api/robot/command · stop · resume / 설계 /api/designs · generate · scan/save / /api/voice/listen (전체 목록 SDD 3.1.1)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4194.0" y="686.0" width="210.0" height="99.0" as="geometry"/></mxCell><mxCell id="backend.in1" value="&lt;b&gt;MQTT d2/hmi/intent ← voice.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;voice.py 문장 {request_design, text, confidence} → /ws intent&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4194.0" y="795.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="backend.in2" value="&lt;b&gt;MQTT 상태 retained 4개 ← bridge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;d2/task/state(state/2 — 상태 · 알림 message_id · run_id) · d2/task/progress(progress/2.0) · d2/safety/state(멈춤 · 잠금) · d2/gripper/state(폭 · 잡힘)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4194.0" y="877.0" width="210.0" height="114.0" as="geometry"/></mxCell><mxCell id="backend.in3" value="&lt;b&gt;MQTT d2/task/scan_result (retained) ← bridge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;scan_result/2.0 → 비교 화면 · 추천 · [그대로 저장]&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4194.0" y="1001.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="backend.in4" value="&lt;b&gt;MQTT wrist_image · scan_image · scan_cloud ← bridge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;바이트 — 손목 검출 JPEG · 스캔 사진 · 점군 PLY&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4194.0" y="1083.0" width="210.0" height="87.0" as="geometry"/></mxCell><mxCell id="backend.in5" value="&lt;b&gt;MQTT …/res ← bridge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;명령 · 정지 · 다시 시작 · 검사 응답 — command · stop · resume 응답 → REST 응답(①) / check_design 응답 check_result/3.0 — 통과 · errors[kind] · 레시피 · 조립 방법 · feasible_order → 검사 결과(⑤) · req_id 짝&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4194.0" y="1180.0" width="210.0" height="141.0" as="geometry"/></mxCell><mxCell id="backend.in6" value="&lt;b&gt;MQTT get_design/req · save_build/req ← bridge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;로봇 PC가 물음 — design_id / build/2&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4194.0" y="1331.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="backend.in7" value="&lt;b&gt;MQTT d2/bridge/alive ← bridge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;1초 · 3초 끊기면 &#x27;로봇 PC 연결 끊김&#x27;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4194.0" y="1413.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="backend.in8" value="&lt;b&gt;MQTT d2/vision/scan_preview · scan_preview_cloud ← bridge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;JSON + PLY(capture ≤ 2 MB · live ≤ 500 KB) — 스캔 중 점군(E-82)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4194.0" y="1495.0" width="210.0" height="101.0" as="geometry"/></mxCell><mxCell id="backend.in9" value="&lt;b&gt;조회 결과 ← db · JSON 파일 /data&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;DesignStore가 읽은 설계 1개(design/4.0) · 설계 목록 요약(+ 최근 조립 결과 · 표시 이름) · 조립 기록 · 참고 설계 후보 · Template 정의&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4194.0" y="1606.0" width="210.0" height="114.0" as="geometry"/></mxCell><mxCell id="backend.in10" value="&lt;b&gt;Claude 응답 ← claude_bridge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;OpenAI 형식 choices · tool_calls / 실패 HTTP 코드 — 504 시간 초과 · 429 구독 한도(둘은 다시 안 부름) · 502 그 밖 · 400 요청 모양&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4194.0" y="1730.0" width="210.0" height="99.0" as="geometry"/></mxCell><mxCell id="backend.out0" value="&lt;b&gt;MQTT d2/hmi/command/req&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;select_design · start · scan · cancel · gripper_open&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4996.0" y="686.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="backend.out1" value="&lt;b&gt;MQTT d2/safety/stop/req · resume/req&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;정지 / 다시 시작 · [정리 끝](둘 다 resume)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4996.0" y="753.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="backend.out2" value="&lt;b&gt;MQTT d2/hmi/voice/listen&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;voice_listen/1 — 한 번 듣기(웹 PC 안)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4996.0" y="835.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="backend.out3" value="&lt;b&gt;MQTT d2/task/check_design/req&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;parts/4.0 + base_recipe (+ 스캔 저장만 made_by &quot;scan&quot;)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4996.0" y="902.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="backend.out4" value="&lt;b&gt;HTTP → claude_bridge :8790&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;OpenAI 형식 /v1/chat/completions(D2_LLM_URL) — 키 없음(자리값 글자만 · 중계가 안 봄)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4996.0" y="984.0" width="210.0" height="85.0" as="geometry"/></mxCell><mxCell id="backend.out5" value="&lt;b&gt;MQTT get_design/res · save_build/res&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;design/4.0 / ok · retry&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4996.0" y="1079.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="backend.out6" value="&lt;b&gt;저장소 읽기 · 쓰기&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;PostgreSQL db(DATABASE_URL) · 비면 JSON 파일 /data&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4996.0" y="1147.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="backend.out7" value="&lt;b&gt;MQTT d2/web/alive&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;1초 (LWT)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4996.0" y="1214.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="backend.out8" value="&lt;b&gt;WebSocket /ws → frontend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;state · progress · safety · scan_result · intent(음성 문장) · 연결 2종(broker · bridge_alive) (전체 목록 SDD 3.1.1)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4996.0" y="1267.0" width="210.0" height="99.0" as="geometry"/></mxCell><mxCell id="backend.out9" value="&lt;b&gt;REST 응답 → frontend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;목록 · 생성 작업 · 스캔 저장 작업 · 명령 결과 · 손목 영상 · 점군 (전체 목록 SDD 3.1.1)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4996.0" y="1376.0" width="210.0" height="71.0" as="geometry"/></mxCell><mxCell id="backend.st0" value="① REST 명령 → MQTT d2/hmi/command/req(select_design · start · scan · cancel · gripper_open) · d2/safety/stop · resume/req → …/res를 REST 응답으로(5초 · 자동 재전송 없음)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4450.0" y="710.0" width="500.0" height="55.0" as="geometry"/></mxCell><mxCell id="backend.st1" value="② retained 상태 5개 · 음성 문장 · 연결 2종(bridge_alive 브리지 · broker 브로커 끊김) · timing(요청 시간 제한, 붙을 때 한 번)을 /ws로 밀어 줌 · 웹 연결 신호 d2/web/alive 1초(LWT)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4450.0" y="775.0" width="500.0" height="55.0" as="geometry"/></mxCell><mxCell id="backend.st2" value="③ 바이트(손목 영상 · 스캔 사진 · 점군 · 점군 미리보기 capture · live)는 마지막 1장만 들고 /ws에는 번호만 → REST(wrist.jpg · scan.jpg · scan_cloud.ply · scan_preview.ply?kind=capture · live)로 내줌 · frontend/out 정적 서빙 · robot.yaml 설계 규칙 읽기 전용(E-78)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4450.0" y="840.0" width="500.0" height="70.0" as="geometry"/></mxCell><mxCell id="backend.st3" value="④ 마이크 버튼 · 로봇 패널 [말로 정지] /api/voice/listen → MQTT d2/hmi/voice/listen(voice_listen/1 — 웹 PC 안만, 브리지 안 거침 · retained 아님)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4450.0" y="920.0" width="500.0" height="55.0" as="geometry"/></mxCell><mxCell id="backend.st4" value="⑤ generate(text, design_id): 고른 설계 = 부모 · 같은 Template 다른 설계는 목록으로(도구 get_design 참고 읽기 — 첫 차례 required · 읽거나 SKIP, 그다음 auto, E-72 10/14 고침) · 요청 글에 [Template 규칙] · 음성이면 made_by voice + 확신도(못 알아들으면 VOICE_UNCLEAR, E-118) · 생성 전체 5분 상한(W108) → Claude(opus · 한 번 260초 · 시간 초과 · 한도면 다시 안 함, 원인을 화면에)가 후보 3개 parts/4.0(위치 · 방향 · 역할 · 그룹 · 순서 sequence · 단계 · 잡기)을 직접 씀 — 프롬프트 규칙 1 ~ 10(8 ~ 10 = W201 조립 규칙: 한 층 같은 방향 · 걸친 면 15 mm · 같은 층 판처럼 붙이기 금지) · 손가락 자리 값은 robot.yaml finger.* · grasp_depth_m(검사와 같은 값, E-121 ⑲)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4450.0" y="1019.0" width="500.0" height="160.0" as="geometry"/></mxCell><mxCell id="backend.st5" value="⑥ 후보마다 새 ID → 맞붙은 쌍(같은 층 긴 면을 맞댄 눕힌 블록) 잡기를 FLAT_LONG으로 맞춤(E-104 ③ — row_grasp.row_orders + 검사 손가락 규칙, 들어가는 블록만) → check_design/req(+ base_recipe = Template V000 레시피, 21번) → 통과만 남기고 모자란 만큼 다시(처음 + 2) · REQUEST_INVALID는 다시 안 만듦 · 실패 kind로 화면 문구 → 사람이 1개 고름 → 저장(안 고른 후보는 버림)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4450.0" y="1189.0" width="500.0" height="100.0" as="geometry"/></mxCell><mxCell id="backend.st6" value="⑦ 스캔 [그대로 저장]: scan_fill — AI가 역할 · 그룹 · 순서 · 잡기 + 부모 고르기(E-79) → 맞붙은 쌍 FLAT_LONG 맞춤 → 검사(made_by &quot;scan&quot; — 21번 Template 건너뜀, E-106) → AI가 채운 칸이 원인이면 다시 채움(최대 2번) → 저장(made_by scan) · 추천 설계 match_scan(일치율 상위 3, E-97)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4450.0" y="1299.0" width="500.0" height="70.0" as="geometry"/></mxCell><mxCell id="backend.st7" value="⑧ 설계 designs/&lt;id&gt;.json(design/4.0) · 조립 기록 builds · AI 호출 기록 gen_logs(NFR-17) — PostgreSQL db(W088 — 표시 이름 display_name · 이름 바꾸기 PUT /api/designs/{id}/name → gen_logs rename · 저장 실패 원인은 backend 로그, E-115) 또는 JSON 파일 폴더 /data. 기본 설계 4개(_V000)는 켤 때 레시피 → 변환기 ② → 같은 ID로 다시 등록(덮어씀 · 검사 안 부름 — 레시피 PR CI) · 이름 &lt;Template&gt;_V&lt;3자리&gt;(E-84) · 저장한 설계는 고치지 않음" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4450.0" y="1413.0" width="500.0" height="115.0" as="geometry"/></mxCell><mxCell id="backend.st8" value="⑨ get_design/req → design/4.0 응답 · save_build/req → builds(같은 run_id 한 번만 · 형식이 틀리면 retry false 영구 거절)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4450.0" y="1538.0" width="500.0" height="40.0" as="geometry"/></mxCell><mxCell id="backend.c0" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1f4fd6;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.218;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend.in0" target="backend.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4414.0" y="735.5"/><mxPoint x="4414.0" y="722.0"/></Array></mxGeometry></mxCell><mxCell id="backend.c1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1f4fd6;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.257;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend.in0" target="backend.st2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4414.0" y="735.5"/><mxPoint x="4414.0" y="858.0"/></Array></mxGeometry></mxCell><mxCell id="backend.c2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1f4fd6;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.436;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend.in0" target="backend.st3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="44