9.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="scan_live_preview.out0" value="&lt;b&gt;/d2/vision/scan_preview (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;kind live(실시간) — 보기 전용 → 브리지 → 화면 점군 창&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4398.0" y="2914.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="scan_live_preview.out1" value="&lt;b&gt;/d2/vision/scan_live_cloud (토픽, 선택)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;RViz 확인용 · 기본 꺼짐&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4398.0" y="2996.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="scan_live_preview.st0" value="① 스캔 중(SCAN_*)에만 1.5 Hz: 깊이 → base 점 → 조립 영역만 → 복셀 5 mm(≤ 500 KB) · 색 · 거르기(capture와 같은 color_cloud, 보기 전용) → live_&lt;k&gt;.ply 돌려 씀(&lt;scan_dir&gt;/&lt;run_id&gt;/, 기본 ~/d2_data/scan — 브리지가 읽음)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4082.0" y="2914.0" width="270.0" height="115.0" as="geometry"/></mxCell><mxCell id="scan_live_preview.st1" value="② scan_preview kind live(실시간) 알림(보기 전용) · (선택) scan_live_cloud PointCloud2 — RViz 확인용, 기본 꺼짐" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4082.0" y="3039.0" width="270.0" height="70.0" as="geometry"/></mxCell><mxCell id="scan_live_preview.c0" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.104;entryDx=0;entryDy=0;" edge="1" parent="1" source="scan_live_preview.in0" target="scan_live_preview.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4046.0" y="2942.5"/><mxPoint x="4046.0" y="2926.0"/></Array></mxGeometry></mxCell><mxCell id="scan_live_preview.c1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1e9e3e;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.104;entryDx=0;entryDy=0;" edge="1" parent="1" source="scan_live_preview.in1" target="scan_live_preview.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4054.0" y="3002.5"/><mxPoint x="4054.0" y="2926.0"/></Array></mxGeometry></mxCell><mxCell id="scan_live_preview.c2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.104;entryDx=0;entryDy=0;" edge="1" parent="1" source="scan_live_preview.in2" target="scan_live_preview.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4062.0" y="3076.5"/><mxPoint x="4062.0" y="2926.0"/></Array></mxGeometry></mxCell><mxCell id="scan_live_preview.c3" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.104;entryDx=0;entryDy=0;" edge="1" parent="1" source="scan_live_preview.in3" target="scan_live_preview.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4070.0" y="3157.5"/><mxPoint x="4070.0" y="2926.0"/></Array></mxGeometry></mxCell><mxCell id="scan_live_preview.c4" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1e9e3e;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="scan_live_preview.st1" target="scan_live_preview.out0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4362.0" y="3074.0"/><mxPoint x="4362.0" y="2950.0"/></Array></mxGeometry></mxCell><mxCell id="scan_live_preview.c5" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="scan_live_preview.st1" target="scan_live_preview.out1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4370.0" y="3074.0"/><mxPoint x="4370.0" y="3025.0"/></Array></mxGeometry></mxCell><mxCell id="scan_live_preview.c6" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9aa5b1;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=0.089;exitY=1.000;exitDx=0;exitDy=0;entryX=0.089;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="scan_live_preview.st0" target="scan_live_preview.st1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pick_place" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7785;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="4868.0" y="2834.0" width="862.0" height="835.0" as="geometry"/></mxCell><mxCell id="pick_place.head" value="&lt;b style=&quot;font-size:16px&quot;&gt;pick_place — 집기·놓기 + 실행기&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dde6f7;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=72;" vertex="1" parent="1"><mxGeometry x="4868.0" y="2834.0" width="862.0" height="50.0" as="geometry"/></mxCell><mxCell id="pick_place.badge" value="&lt;b&gt;노드&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="4878.0" y="2846.0" width="52.0" height="24.0" as="geometry"/></mxCell><mxCell id="pick_place.meta" value="로봇 동작 · 패키지 d2_robot/d2_motion&lt;br&gt;&lt;b&gt;&lt;span style=&quot;color:#5566b5&quot;&gt;돌리는 곳: 호스트&lt;/span&gt;&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="5370.0" y="2838.0" width="350.0" height="42.0" as="geometry"/></mxCell><mxCell id="pick_place.col10" value="&lt;b&gt;입력 — 받는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="4878.0" y="2888.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="pick_place.col266" value="&lt;b&gt;처리 — 하는 일(번호 순)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="5134.0" y="2888.0" width="330.0" height="22.0" as="geometry"/></mxCell><mxCell id="pick_place.col642" value="&lt;b&gt;출력 — 내보내는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="5510.0" y="2888.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="pick_place.in0" value="&lt;b&gt;/d2/motion/pick_place (액션 받음)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;부품 1개 목표 — pick · place 자세(블록 중심) · grasp · open_width_m · obstacles&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4878.0" y="2914.0" width="210.0" height="86.0" as="geometry"/></mxCell><mxCell id="pick_place.in1" value="&lt;b&gt;/d2/motion/move_to (서비스 받음)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;robot.yaml &lt;이름&gt;_pose · speed_ratio&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4878.0" y="3010.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="pick_place.in2" value="&lt;b&gt;/d2/safety/state (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;멈춤 → 목표 취소(CANCELED) · 잠긴 동안 거절&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4878.0" y="3092.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="pick_place.in3" value="&lt;b&gt;/joint_states · robot.yaml · tcp.json&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;관절값 · 좌표 · 그리퍼 값 · 속도 · TCP = 손가락 가운데(E-81) · 세우기 교시 standup_taught&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4878.0" y="3159.0" width="210.0" height="86.0" as="geometry"/></mxCell><mxCell id="pick_place.in4" value="&lt;b&gt;/d2/gripper/state (토픽) · command 응답 ← gripper&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;상태: 폭 · 잡힘 / 응답: success · grasped · width_m · reason — 잡힘 확인은 응답으로 (전체 칸 IRD 4.1 · 4.2)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="4878.0" y="3255.0" width="210.0" height="100.0" as="geometry"/></mxCell><mxCell id="pick_place.out0" value="&lt;b&gt;move_group (MoveIt2)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;경로 계획 · 실행&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="5510.0" y="2914.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="pick_place.out1" value="&lt;b&gt;/d2/gripper/command (서비스)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;폭 · 힘&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="5510.0" y="2967.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="pick_place.out2" value="&lt;b&gt;/d2/motion/scene/attach (서비스)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;붙이기 · 떼기&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="5510.0" y="3020.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="pick_place.out3" value="&lt;b&gt;중간 보고 · 결과 → task&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;step · 성공 · 실패 코드&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="5510.0" y="3088.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="pick_place.out4" value="&lt;b&gt;/d2/motion/path_markers (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;계획한 경로 TCP 선 → RViz(보기 전용, 받는 노드 없음)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="5510.0" y="3141.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="pick_place.out5" value="&lt;b&gt;/dsr_moveit_controller/joint_trajectory · move_stop (SafeStop 공용) → 제어기&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;취소 · TIMEOUT · ERROR · Ctrl+C 때 직접 세움 — 잠금 · safety/state 방송은 안 함&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="5510.0" y="3223.0" width="210.0" height="101.0" as="geometry"/></mxCell><mxCell id="pick_place.st0" value="① approach — 집을 블록 위 0.08 m · 흩뿌림이면 주변 블록을 부풀린 장애물로 공중 이동(#126 — 옛 공급 칸 가정 상자는 지움, #176) · 평소 속도 speed_scale 0.5(자유 이동 · 들기 · 빠지기 · 받침에 놓기 같음) · IK KDL 50 ms" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="5134.0" y="2914.0" width="330.0" height="85.0" as="geometry"/></mxCell><mxCell id="pick_place.st1" value="② grasp — 그리퍼 기본 활짝(명령 0.110 m — 실제 열림 약 101.5 mm) → 블록 바로 위에서 잡기 폭 → 내려가 닫기(10 N, 집으러 내려가기만 0.4배 = 0.2) → 폭으로 잡혔는지 확인 · TILT(기울여 집기 3 ~ 45°) · TIP(받침 눕히기) · CENTER_FLAT_*(받침 맞추기 — task 는 지금 반대 폭 FLAT_* 로 보냄) · STANDUP_HIGH · STANDUP_SIDE(받침 세우기 — standup_taught 교시 동작, 진입 뒤 모두 MoveL)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="5134.0" y="3009.0" width="330.0" height="145.0" as="geometry"/></mxCell><mxCell id="pick_place.st2" value="③ attach — SceneAttach로 쥔 블록을 팔에 붙임(E-76) · held_quat = 쥔 상자 방향(E-100 — 세우기용)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="5134.0" y="3164.0" width="330.0" height="55.0" as="geometry"/></mxCell><mxCell id="pick_place.st3" value="④ lift(같은 직선을 평소 속도로) → move(BiTRRT → RRTConnect, 놓인 블록과 여유 20 mm → 10 mm → 안 풀리면 0(실제 크기)으로 마지막 한 번 — 흩뿌린 주변 블록은 여유 0에도 실제 크기로 피함) → place — 조립 자리 하강만 0.4배(받침은 평소) · 위치 제어로 0.001 m 위에서 놓기 · 조립 자리에 FLAT_SHORT로 놓는 블록만 놓기 TCP를 긴 축으로 +2.4 mm(motion.place_offset_flat_short_m, #195 — 받침 · FLAT_LONG은 안 옮김)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="5134.0" y="3229.0" width="330.0" height="145.0" as="geometry"/></mxCell><mxCell id="pick_place.st4" value="⑤ detach — 놓은 블록으로 장면에 남김 → retreat(내려간 직선을 평소 속도로 다시 계획, 안 풀리면 되짚기)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="5134.0" y="3384.0" width="330.0" height="55.0" as="geometry"/></mxCell><mxCell id="pick_place.st5" value="⑥ 결과 — 성공 · 실패 코드(GRASP_FAILED · GRIPPER_NO_RESPONSE · STOPPED …) · 그리퍼 폭 · 걸린 시간" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="5134.0" y="3449.0" width="330.0" height="55.0" as="geometry"/></mxCell><mxCell id="pick_place.st6" value="⑦ move_to — robot.yaml &lt;이름&gt;_pose(관측 · 공급 관측 · 받침 관측 · 홈 · 스캔 5자세) · 스캔 이동 때 구조물 상자 structure_box_m 피함(W186)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="5134.0" y="3514.0" width="330.0" height="70.0" as="geometry"/></mxCell><mxCell id="pick_place.st7" value="⑧ 정지 · task 취소면 진행 중 목표 취소 → 서기 궤적 · 잠긴 동안 거절(STOPPED) · 다른 목표 중 BUSY" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="5134.0" y="3594.0" width="330.0" height="55.0" as="geometry"/></mxCell><mxCell id="pick_place.c0" style="edgeStyle=none;rounded=0;html=1;strokeColor=#111111;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.141;entryDx=0;entryDy=0;" edge="1" parent="1" source="pick_place.in0" target="pick_place.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5098.0" y="2957.0"/><mxPoint x="5098.0" y="2926.0"/></Array></mxGeometry></mxCell><mxCell id="pick_place.c1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#111111;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.171;entryDx=0;entryDy=0;" edge="1" parent="1" source="pick_place.in1" target="pick_place.st6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5106.0" y="3046.0"/><mxPoint x="5106.0" y="3526.0"/></Array></mxGeometry></mxCell><mxCell id="pick_place.c2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#e00000;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.218;entryDx=0;entryDy=0;" edge="1" parent="1" source="pick_place.in2" target="pick_place.st7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5114.0" y="3120.5"/><mxPoint x="5114.0" y="3606.0"/></Array></mxGeometry></mxCell><mxCell id="pick_place.c3" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.141;entryDx=0;entryDy=0;" edge="1" parent="1" source="pick_place.in3" target="pick_place.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5122.0" y="3202.0"/><mxPoint x="5122.0" y="2926.0"/></Array></mxGeometry></mxCell><mxCell id="pick_place.c4" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exi