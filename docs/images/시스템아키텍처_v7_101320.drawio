="1" source="task.st12" target="task.st13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wrist_block" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7785;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2674.0" y="2834.0" width="892.0" height="953.0" as="geometry"/></mxCell><mxCell id="wrist_block.head" value="&lt;b style=&quot;font-size:16px&quot;&gt;wrist_block — 손목 블록 인식 · 흩어진 블록 찾기 + 스캔 추론기&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e2efda;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=72;" vertex="1" parent="1"><mxGeometry x="2674.0" y="2834.0" width="892.0" height="50.0" as="geometry"/></mxCell><mxCell id="wrist_block.badge" value="&lt;b&gt;노드&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2684.0" y="2846.0" width="52.0" height="24.0" as="geometry"/></mxCell><mxCell id="wrist_block.meta" value="비전 · 패키지 d2_vision&lt;br&gt;&lt;b&gt;&lt;span style=&quot;color:#5566b5&quot;&gt;돌리는 곳: 호스트&lt;/span&gt;&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3206.0" y="2838.0" width="350.0" height="42.0" as="geometry"/></mxCell><mxCell id="wrist_block.col10" value="&lt;b&gt;입력 — 받는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="2684.0" y="2888.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="wrist_block.col266" value="&lt;b&gt;처리 — 하는 일(번호 순)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="2940.0" y="2888.0" width="360.0" height="22.0" as="geometry"/></mxCell><mxCell id="wrist_block.col672" value="&lt;b&gt;출력 — 내보내는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="3346.0" y="2888.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="wrist_block.grp0" value="&lt;b&gt;클래스 BlockChecker — 배치 확인&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="2934.0" y="2914.0" width="372.0" height="201.0" as="geometry"/></mxCell><mxCell id="wrist_block.grp1" value="&lt;b&gt;클래스 BlockFinder — 흩어진 블록 찾기&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="2934.0" y="3123.0" width="372.0" height="286.0" as="geometry"/></mxCell><mxCell id="wrist_block.grp2" value="&lt;b&gt;클래스 StructureScanner · LayerSolver — 스캔 추론기&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="2934.0" y="3417.0" width="372.0" height="306.0" as="geometry"/></mxCell><mxCell id="wrist_block.in0" value="&lt;b&gt;손목 카메라 (realsense2_camera)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;컬러 · 정렬 깊이 · camera_info&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2684.0" y="2914.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="wrist_block.in1" value="&lt;b&gt;/d2/vision/check_progress (서비스 받음)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;design_id · run_id · part_ids&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2684.0" y="2982.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="wrist_block.in2" value="&lt;b&gt;/d2/vision/find_blocks (서비스 받음)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;run_id · height_map · area spare · assembly(+ design_id · part_id — A4 놓은 블록 다시 재기, #177) — 공급 · 받침 · 조립 자리&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2684.0" y="3050.0" width="210.0" height="100.0" as="geometry"/></mxCell><mxCell id="wrist_block.in3" value="&lt;b&gt;/d2/vision/scan_capture · scan_infer (서비스 받음)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;pose_id · run_id / 추론 요청&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2684.0" y="3160.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="wrist_block.in4" value="&lt;b&gt;TF base_link → rg2_tcp · 손목 보정값 (파일)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;config/T_rg2tcp2camera.npy(카메라 → rg2_tcp hand-eye, W156) · 같은 이름 .json tilt_shift(기울기 밀림 보정 — E-85 뒤 0 = 꺼진 길)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2684.0" y="3228.0" width="210.0" height="100.0" as="geometry"/></mxCell><mxCell id="wrist_block.in5" value="&lt;b&gt;get_design 응답 ← bridge (설계 캐시)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;design/4.0 — run_id 바뀔 때만 다시 읽음 · check_progress · find_blocks assembly가 같이 씀 · design_source remote(기본) = get_design · local = recipe_dir 파일(task 와 같은 값)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2684.0" y="3338.0" width="210.0" height="128.0" as="geometry"/></mxCell><mxCell id="wrist_block.in6" value="&lt;b&gt;YOLO seg 모델 (저장소 파일)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;src/d2_vision/models/*.pt — 못 읽으면 노드 안 켜짐(E-86)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2684.0" y="3476.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="wrist_block.in7" value="&lt;b&gt;robot.yaml · tcp.json ← bringup config&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;조립 원점 assembly_origin · block_size_m · table_z_m · find.min_gap_mm · spare_spots · supply_area_m / tcp.json = 자세 자료 기록용 (전체 키 IRD 9장)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2684.0" y="3543.0" width="210.0" height="114.0" as="geometry"/></mxCell><mxCell id="wrist_block.in8" value="&lt;b&gt;/d2/task/state pick ← task (#183)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;RELIABLE · TRANSIENT_LOCAL 구독 — (image_seq · index · ranks)가 바뀔 때만 공급 그림을 다시 그림&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2684.0" y="3667.0" width="210.0" height="100.0" as="geometry"/></mxCell><mxCell id="wrist_block.out0" value="&lt;b&gt;check_progress 응답 → task&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;부품마다 state · 높이 · 오차&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="3346.0" y="2914.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="wrist_block.out1" value="&lt;b&gt;find_blocks 응답 → task&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;blocks[자세 up · yaw · 틈 gap_mm · 겹침 · 기울어짐] · height_map / assembly: 블록 1개 · corners_z_m · rejected · measured_stamp (전체 칸 IRD 4.2) · 공급 응답에 image_seq(비전이 매김)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="3346.0" y="2967.0" width="210.0" height="127.0" as="geometry"/></mxCell><mxCell id="wrist_block.out2" value="&lt;b&gt;scan_capture · scan_infer 응답 → task&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;ok · blocks/2 · 추정 수(inferred_count) · image_path · cloud_path — 신뢰도 미달이면 ok:false SCAN_FAILED (전체 칸 IRD 4.2)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="3346.0" y="3104.0" width="210.0" height="114.0" as="geometry"/></mxCell><mxCell id="wrist_block.out3" value="&lt;b&gt;/d2/vision/scan_preview (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;scan_preview/1.0 kind capture(누적) — PLY 경로&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="3346.0" y="3228.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="wrist_block.out4" value="&lt;b&gt;/d2/vision/wrist_image (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;검출 윤곽 그린 JPEG → 브리지&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="3346.0" y="3310.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="wrist_block.out5" value="&lt;b&gt;/d2/hmi/get_design (서비스)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;design_id → design/4.0 (브리지가 응답함)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="3346.0" y="3363.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="wrist_block.out6" value="&lt;b&gt;/d2/vision/wrist_image 순위 · 작업대 그림 → 브리지 (#183)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;공급 = 우선순위 번호 ①② · 고른 블록 반투명 칠하기 · 낱말 FLAT · EDGE · STAND · TILT n° / 받침 다시 재기 = 목표 빨강 / 작업대(check_progress · A4 응답 때) = 판정 색 + 부품 짧은 이름(LEG 1-3)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="3346.0" y="3430.0" width="210.0" height="142.0" as="geometry"/></mxCell><mxCell id="wrist_block.st0" value="① 관측 자세 깊이 10장(중앙값) + TF 자세 × 보정값 → base_link 점군" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2940.0" y="2938.0" width="360.0" height="40.0" as="geometry"/></mxCell><mxCell id="wrist_block.st1" value="② 부품마다 설계 자리 높이 → state(present · absent · occluded · unknown) · top_z_m · dz_m (dx · dy는 NaN — 판정 없음) · 허용 = 두께 절반 · 판정 칸 = 설계 자리(위에서 본 사각형)를 사방 4 mm 안쪽으로(바닥 좁은 세운 블록은 2 mm, e35c50d) · 5 mm 격자 최고 z → 중앙값 · 셀 6개 미만 = unknown · 위 블록에 덮인 부품 = present(높이 NaN, #156)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2940.0" y="2988.0" width="360.0" height="115.0" as="geometry"/></mxCell><mxCell id="wrist_block.st2" value="③ find_blocks: YOLO seg 마스크(예비 엣지는 파라미터로만) → 윤곽 안 깊이 → 자세 up · yaw · 윗면 높이 · 틈 gap_mm(막는 게 없으면 99) · clear · 겹침 · 기울어짐(높이 차 ≥ 5 mm 또는 눕힌 블록(윗면 짧은 변 ≥ 20 mm)은 윗면 ≥ 5° — center_top_z_m · normal, E-111 B1) · 높이 지도(height_map) · area spare면 받침 위 블록을 깊이로 잼(spare_measure) · area assembly면 방금 놓은 블록 하나를 잼 — placed_method mask(기본, #187 · #196): 깊이로 기울어짐 · 덮임 · 세움을 먼저 보고 크기 · 위치 · yaw는 컬러 YOLO 마스크 + 카메라 광선(placed_mask) · 모서리 높이 corners_z_m(#191) · 폭 방향 각 10° · 한쪽 끝 들림도 기울어짐(#186) / depth: 설계 자리 둘레 깊이만(measure_placed — 가운데와 이어진 윗면만 · 거절 rejected 7코드 · measured_stamp, #177) → 윤곽 그린 JPEG" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2940.0" y="3147.0" width="360.0" height="250.0" as="geometry"/></mxCell><mxCell id="wrist_block.st3" value="④ scan_capture: 자세마다 깊이 여러 장 평균 + YOLO 마스크 + 사진 저장 → 지금까지 모은 점군 PLY(화면용 색 — 바닥 회색 · 구조물 높이별 파랑 → 빨강, 부스러기 · 조립 영역 밖 덩어리 뺌 — 보기 전용, #158) = &lt;scan_dir&gt;/&lt;run_id&gt;/preview_&lt;n&gt;.ply(복셀 3 mm · ≤ 2 MB · 기본 ~/d2_data/scan — 브리지가 cloud_path 로 읽음) + scan_preview kind capture(누적, E-82 A)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2940.0" y="3441.0" width="360.0" height="130.0" as="geometry"/></mxCell><mxCell id="wrist_block.st4" value="⑤ scan_infer(LayerSolver v12g — 층 지도 + 정수계획): 블록 자리 · 방향 · 가려진 블록(inferred) → 바닥 가운데 = (0, 0) · scan_num → ok · blocks/2 · inferred_count · nearest_base(기본 설계를 골랐을 때) · 점군 cloud.ply · 사진 color.png(같은 run_id 폴더) — 신뢰도 미달이면 ok:false SCAN_FAILED · 임시 이름 scan_&lt;family&gt;_&lt;번호&gt; (E-88 65개 중 62개 통과)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2940.0" y="3581.0" width="360.0" height="130.0" as="geometry"/></mxCell><mxCell id="wrist_block.c0" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.300;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrist_block.in0" target="wrist_block.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2904.0" y="2943.0"/><mxPoint x="2904.0" y="2950.0"/></Array></mxGeometry></mxCell><mxCell id="wrist_block.c1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.072;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrist_block.in0" target="wrist_block.st2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2904.0" y="2943.0"/><mxPoint x="2904.0" y="3165.0"/></Array></mxGeometry></mxCell><mxCell id="wrist_block.c2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.185;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrist_block.in0" target="wrist_block.st3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2904.0" y="2943.0"/><mxPoint x="2904.0" y="3465.0"/></Array></mxGeometry></mxCell><mxCell id="wrist_block.c3" style="edgeStyle=none;rounded=0;html=1;stro