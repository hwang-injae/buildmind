n0" value="&lt;b&gt;손목 카메라 (realsense2_camera)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;컬러 · 정렬 깊이 · camera_info&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2684.0" y="2572.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="wrist_block.in1" value="&lt;b&gt;/d2/vision/check_progress (서비스 받음)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;design_id · run_id · part_ids&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2684.0" y="2640.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="wrist_block.in2" value="&lt;b&gt;/d2/vision/find_blocks (서비스 받음)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;run_id · height_map · area spare · assembly(+ design_id · part_id — A4 놓은 블록 다시 재기, #177) — 공급 · 받침 · 조립 자리&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2684.0" y="2708.0" width="210.0" height="100.0" as="geometry"/></mxCell><mxCell id="wrist_block.in3" value="&lt;b&gt;/d2/vision/scan_capture · scan_infer (서비스 받음)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;pose_id · run_id / 추론 요청&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2684.0" y="2818.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="wrist_block.in4" value="&lt;b&gt;TF base_link → rg2_tcp · 손목 보정값&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;rg2_tcp 틀 hand-eye(W156) · 기울기 밀림 고침(E-83 · E-85)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2684.0" y="2886.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="wrist_block.in5" value="&lt;b&gt;get_design 답 (설계 캐시)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;design/4.0 — run_id 바뀔 때만 다시 읽음 · check_progress · find_blocks assembly가 같이 씀&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2684.0" y="2968.0" width="210.0" height="71.0" as="geometry"/></mxCell><mxCell id="wrist_block.in6" value="&lt;b&gt;YOLO seg 모델 (저장소 파일)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;src/d2_vision/models/*.pt — 못 읽으면 노드 안 켜짐(E-86)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2684.0" y="3049.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="wrist_block.out0" value="&lt;b&gt;check_progress 답&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;부품마다 state · 높이 · 오차&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="3346.0" y="2572.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="wrist_block.out1" value="&lt;b&gt;find_blocks 답&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;blocks[x · y · top_z · yaw · up · gap_mm · clear · overlap · tilted · center_top_z · normal · base_z] · height_map / assembly: blocks 1개(+ size_mm) 또는 [] · rejected · detail · measured_stamp&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="3346.0" y="2625.0" width="210.0" height="127.0" as="geometry"/></mxCell><mxCell id="wrist_block.out2" value="&lt;b&gt;scan_capture · scan_infer 답&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;points / blocks/2 · 추정 수 · 신뢰도 · image_path · cloud_path&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="3346.0" y="2762.0" width="210.0" height="71.0" as="geometry"/></mxCell><mxCell id="wrist_block.out3" value="&lt;b&gt;/d2/vision/scan_preview (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;scan_preview/1.0 kind capture — 누적 PLY 경로&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="3346.0" y="2843.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="wrist_block.out4" value="&lt;b&gt;/d2/vision/wrist_image (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;검출 윤곽 그린 JPEG → 다리&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="3346.0" y="2925.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="wrist_block.out5" value="&lt;b&gt;/d2/hmi/get_design (서비스)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;design_id → design/4.0 (다리가 답함)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="3346.0" y="2978.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="wrist_block.st0" value="① 관측 자세 깊이 10장(중앙값) + TF 자세 × 보정값 → base_link 점군" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2940.0" y="2596.0" width="360.0" height="40.0" as="geometry"/></mxCell><mxCell id="wrist_block.st1" value="② 부품마다 설계 자리 높이 → state(present · absent · occluded · unknown) · top_z_m · dz_m (dx · dy는 NaN — 판정 없음) · 허용 = 두께 절반 · 판정 칸 = 바닥에서 4 mm 안쪽(세운 블록은 2 mm, e35c50d) · 위 블록에 덮인 부품 = present(높이 NaN, #156)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2940.0" y="2646.0" width="360.0" height="100.0" as="geometry"/></mxCell><mxCell id="wrist_block.st2" value="③ find_blocks: YOLO seg 마스크(예비 엣지는 파라미터로만) → 윤곽 안 깊이 → 자세 up · yaw · 윗면 높이 · 틈 gap_mm(막는 게 없으면 99) · clear · 겹침 · 기울어짐(높이 차 ≥ 5 mm 또는 윗면 ≥ 5° — center_top_z_m · normal, E-111 B1) · 높이 지도(height_map) · area spare면 받침 위 블록을 깊이로 잼(spare_measure) · area assembly면 설계 자리 둘레 깊이로 방금 놓은 블록 하나를 잼(measure_placed — 가운데와 이어진 윗면만 · 거절 rejected 7코드 · measured_stamp, #177) → 윤곽 그린 JPEG" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2940.0" y="2790.0" width="360.0" height="175.0" as="geometry"/></mxCell><mxCell id="wrist_block.st3" value="④ scan_capture: 자세마다 깊이 여러 장 평균 + YOLO 마스크 + 사진 저장 → 지금까지 모은 점군 PLY(화면용 색 — 바닥 회색 · 구조물 높이별 파랑 → 빨강, 부스러기 · 조립 영역 밖 덩어리 뺌 — 보기 전용, #158) + scan_preview A(index)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2940.0" y="3009.0" width="360.0" height="85.0" as="geometry"/></mxCell><mxCell id="wrist_block.st4" value="⑤ scan_infer(LayerSolver v12g — 층 지도 + 정수계획): 블록 자리 · 방향 · 가려진 블록(inferred) → 바닥 가운데 = (0, 0) · scan_num → blocks/2 + 신뢰도 · 점군 PLY · 사진 (E-88 통과 62/65)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2940.0" y="3104.0" width="360.0" height="70.0" as="geometry"/></mxCell><mxCell id="wrist_block.c0" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.300;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrist_block.in0" target="wrist_block.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2904.0" y="2601.0"/><mxPoint x="2904.0" y="2608.0"/></Array></mxGeometry></mxCell><mxCell id="wrist_block.c1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.103;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrist_block.in0" target="wrist_block.st2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2904.0" y="2601.0"/><mxPoint x="2904.0" y="2808.0"/></Array></mxGeometry></mxCell><mxCell id="wrist_block.c2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.282;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrist_block.in0" target="wrist_block.st3"><mxGeometry relativ