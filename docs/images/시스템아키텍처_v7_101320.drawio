1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="voice.st3" target="voice.out2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5462.7" y="932.5"/><mxPoint x="5462.7" y="904.5"/></Array></mxGeometry></mxCell><mxCell id="voice.c7" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="voice.st2" target="voice.out3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5470.7" y="845.0"/><mxPoint x="5470.7" y="971.5"/></Array></mxGeometry></mxCell><mxCell id="voice.c8" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9aa5b1;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=0.073;exitY=1.000;exitDx=0;exitDy=0;entryX=0.073;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="voice.st0" target="voice.st1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="voice.c9" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9aa5b1;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=0.073;exitY=1.000;exitDx=0;exitDy=0;entryX=0.073;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="voice.st1" target="voice.st2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="voice.c10" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9aa5b1;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=0.073;exitY=1.000;exitDx=0;exitDy=0;entryX=0.073;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="voice.st2" target="voice.st3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="voice.c11" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9aa5b1;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=0.073;exitY=1.000;exitDx=0;exitDy=0;entryX=0.073;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="voice.st3" target="voice.st4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mqtt" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7785;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6090.0" y="606.0" width="912.0" height="559.0" as="geometry"/></mxCell><mxCell id="mqtt.head" value="&lt;b style=&quot;font-size:16px&quot;&gt;mosquitto — MQTT 브로커 (웹 PC 컨테이너 · 1883)&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fde9d9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=72;" vertex="1" parent="1"><mxGeometry x="6090.0" y="606.0" width="912.0" height="50.0" as="geometry"/></mxCell><mxCell id="mqtt.badge" value="&lt;b&gt;노드&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="6100.0" y="618.0" width="52.0" height="24.0" as="geometry"/></mxCell><mxCell id="mqtt.meta" value="HMI · 패키지 web/mosquitto&lt;br&gt;&lt;b&gt;&lt;span style=&quot;color:#1565c0&quot;&gt;돌리는 곳: 컨테이너 mosquitto&lt;/span&gt;&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="6642.0" y="610.0" width="350.0" height="42.0" as="geometry"/></mxCell><mxCell id="mqtt.col10" value="&lt;b&gt;입력 — 받는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="6100.0" y="660.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="mqtt.col266" value="&lt;b&gt;처리 — 하는 일(번호 순)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="6356.0" y="660.0" width="380.0" height="22.0" as="geometry"/></mxCell><mxCell id="mqtt.col692" value="&lt;b&gt;출력 — 내보내는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="6782.0" y="660.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="mqtt.grp0" value="&lt;b&gt;전달만 · 토픽 d2/&lt;ROS 이름&gt; · 규칙 bridge_codec.py&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="6350.0" y="686.0" width="392.0" height="461.0" as="geometry"/></mxCell><mxCell id="mqtt.in0" value="&lt;b&gt;웹 PC 클라이언트가 발행&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;backend(d2_web) — …/req · d2/web/alive(LWT) · voice/listen · get_design/res · save_build/res · voice.py — intent · safety/stop/req&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="6100.0" y="686.0" width="210.0" height="99.0" as="geometry"/></mxCell><mxCell id="mqtt.in1" value="&lt;b&gt;로봇 PC 클라이언트가 발행&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;bridge — 상태 토픽 5개 · 바이트 · …/res · get_design/req · save_build/req · d2/bridge/alive(LWT)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="6100.0" y="795.0" width="210.0" height="85.0" as="geometry"/></mxCell><mxCell id="mqtt.out0" value="&lt;b&gt;구독자에게 전달 → 웹 PC&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;backend: 상태 5개 · 바이트 · …/res · get_design/req · save_build/req · bridge/alive · intent · voice.py: voice/listen&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="6782.0" y="686.0" width="210.0" height="99.0" as="geometry"/></mxCell><mxCell id="mqtt.out1" value="&lt;b&gt;구독자에게 전달 → 로봇 PC&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;bridge: …/req · d2/web/alive · intent · safety/stop/req(음성) · get_design/res · save_build/res&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="6782.0" y="795.0" width="210.0" height="85.0" as="geometry"/></mxCell><mxCell id="mqtt.st0" value="① 요청 · 응답 짝: …/req → …/res + req_id(QoS 1) — hmi/command · safety/stop · resume · task/check_design(웹 → 로봇) · hmi/get_design · save_build(로봇 → 웹). 5초 안 답 없으면 보낸 쪽이 TIMEOUT · 자동 재전송 없음" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="6356.0" y="710.0" width="380.0" height="85.0" as="geometry"/></mxCell><mxCell id="mqtt.st1" value="② 상태 retained(마지막 값 보관 — 늦게 붙어도 바로 받음): d2/task/state · progress · scan_result · d2/safety/state · d2/gripper/state" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="6356.0" y="805.0" width="380.0" height="55.0" as="geometry"/></mxCell><mxCell id="mqtt.st2" value="③ 바이트(retained 아님): d2/vision/wrist_image(QoS 0) · scan_image(≤ 500 KB) · scan_cloud(PLY ≤ 2 MB) · scan_preview(JSON) + scan_preview_cloud(PLY)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="6356.0" y="870.0" width="380.0" height="55.0" as="geometry"/></mxCell><mxCell id="mqtt.st3" value="④ 연결 신호: d2/bridge/alive · d2/web/alive 1초 — 갑자기 끊기면 브로커가 LWT(alive false)를 남김 · 3초 끊김 판단은 받는 쪽(화면 · 작업 관리자)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="6356.0" y="935.0" width="380.0" height="55.0" as="geometry"/></mxCell><mxCell id="mqtt.st4" value="⑤ 웹 PC 안만(다리 안 거침): d2/hmi/voice/listen · d2/hmi/intent(voice.py → backend — 다리도 구독해 ROS /d2/hmi/intent로)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="6356.0" y="1000.0" width="380.0" height="55.0" as="geometry"/></mxCell><mxCell id="mqtt.st5" value="⑥ 공개 범위: 웹 PC Wi-Fi IPv4:1883에만 열고 DOCKER-USER로 로봇 PC IP만(#136) · allow_anonymous · persistence false · restart no(재부팅 뒤 방화벽 확인 전 자동 공개 안 함)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="6356.0" y="1065.0" width="380.0" height="70.0" as="geometry"/></mxCell><mxCell id="mqtt.c0" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.141;entryDx=0;entryDy=0;" edge="1" parent="1" source="mqtt.in0" target="mqtt.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="6320.0" y="735.5"/><mxPoint x="6320.0" y="722.0"/></Array></mxGeometry></mxCell><mxCell id="mqtt.c1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.327;entryDx=0;entryDy=0;" edge="1" parent="1" source="mqtt.in0" target="mqtt.st3"><mxGeometry relative="1" as="geometry"><Array as="po