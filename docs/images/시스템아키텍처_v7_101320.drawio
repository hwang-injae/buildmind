yDy=0;" edge="1" parent="1" source="scene_manager.st2" target="scene_manager.out0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="6536.0" y="3154.0"/><mxPoint x="6536.0" y="2935.5"/></Array></mxGeometry></mxCell><mxCell id="gripper" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7785;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="7042.0" y="2834.0" width="792.0" height="365.0" as="geometry"/></mxCell><mxCell id="gripper.head" value="&lt;b style=&quot;font-size:16px&quot;&gt;gripper — 그리퍼 노드&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dde6f7;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=72;" vertex="1" parent="1"><mxGeometry x="7042.0" y="2834.0" width="792.0" height="50.0" as="geometry"/></mxCell><mxCell id="gripper.badge" value="&lt;b&gt;노드&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="7052.0" y="2846.0" width="52.0" height="24.0" as="geometry"/></mxCell><mxCell id="gripper.meta" value="로봇 동작 · 패키지 d2_robot/d2_gripper&lt;br&gt;&lt;b&gt;&lt;span style=&quot;color:#5566b5&quot;&gt;돌리는 곳: 호스트&lt;/span&gt;&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="7474.0" y="2838.0" width="350.0" height="42.0" as="geometry"/></mxCell><mxCell id="gripper.col10" value="&lt;b&gt;입력 — 받는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="7052.0" y="2888.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="gripper.col266" value="&lt;b&gt;처리 — 하는 일(번호 순)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="7308.0" y="2888.0" width="260.0" height="22.0" as="geometry"/></mxCell><mxCell id="gripper.col572" value="&lt;b&gt;출력 — 내보내는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="7614.0" y="2888.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="gripper.in0" value="&lt;b&gt;/d2/gripper/command (서비스 받음)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;폭 · 힘 — pick_place · gripper_open(작업 관리자, 정지 잠금 때)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="7052.0" y="2914.0" width="210.0" height="86.0" as="geometry"/></mxCell><mxCell id="gripper.in1" value="&lt;b&gt;/onrobot_joint_states (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;드라이버 피드백 — 손가락 폭&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="7052.0" y="3010.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="gripper.out0" value="&lt;b&gt;command 응답 → pick_place · task&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;success · grasped · width_m · reason(GRIPPER_NO_RESPONSE · NO_FEEDBACK)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="7614.0" y="2914.0" width="210.0" height="86.0" as="geometry"/></mxCell><mxCell id="gripper.out1" value="&lt;b&gt;/d2/gripper/state (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;폭 · 잡힘 → task · pick_place · 브리지&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="7614.0" y="3010.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="gripper.out2" value="&lt;b&gt;/onrobot/sendCommand&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;서비스 — onrobot_rg_control 드라이버(브링업) → RG2 Modbus TCP&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="7614.0" y="3077.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="gripper.st0" value="① 명령 폭 + 8.5 mm(command_offset) — 상한 max_width_m 0.110(드라이버 명령 상한 = 활짝, 실제 열림 약 101.5 mm, E-108) · 힘 10 N → 드라이버 /onrobot/sendCommand" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="7308.0" y="2914.0" width="260.0" height="85.0" as="geometry"/></mxCell><mxCell id="gripper.st1" value="② 폭이 멈출 때까지 기다림(4 s)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="7308.0" y="3009.0" width="260.0" height="25.0" as="geometry"/></mxCell><mxCell id="gripper.st2" value="③ 멈춘 폭(표시 폭 − 9.4 mm)이 명령 폭보다 2 mm 넘게 크고 잡기 폭 ±5 mm 안이면 잡힘 · 응답 없으면 GRIPPER_NO_RESPONSE · 1 s 안 폭 못 읽으면 NO_FEEDBACK · virtual 이면 폭 NaN" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="7308.0" y="3044.0" width="260.0" height="100.0" as="geometry"/></mxCell><mxCell id="gripper.st3" value="④ 상태 1초 1번 + 바뀔 때" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="7308.0" y="3154.0" width="260.0" height="25.0" as="geometry"/></mxCell><mxCell id="gripper.c0" style="edgeStyle=none;rounded=0;html=1;strokeColor=#111111;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.141;entryDx=0;entryDy=0;" edge="1" parent="1" source="gripper.in0" target="gripper.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7272.0" y="2957.0"/><mxPoint x="7272.0" y="2926.0"/></Array></mxGeometry></mxCell><mxCell id="gripper.c1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.480;entryDx=0;entryDy=0;" edge="1" parent="1" source="gripper.in1" target="gripper.st1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7280.0" y="3031.5"/><mxPoint x="7280.0" y="3021.0"/></Array></mxGeometry></mxCell><mxCell id="gripper.c2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.180;entryDx=0;entryDy=0;" edge="1" parent="1" source="gripper.in1" target="gripper.st2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7280.0" y="3031.5"/><mxPoint x="7280.0" y="3062.0"/></Array></mxGeometry></mxCell><mxCell id="gripper.c3" style="edgeStyle=none;rounded=0;html=1;strokeColor=#111111;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="gripper.st2" target="gripper.out0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7578.0" y="3094.0"/><mxPoint x="7578.0" y="2957.0"/></Array></mxGeometry></mxCell><mxCell id="gripper.c4" style="edgeStyle=none;rounded=0;html=1;strokeColor=#111111;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="gripper.st3" target="gripper.out1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7586.0" y="3166.5"/><mxPoint x="7586.0" y="3038.5"/></Array></mxGeometry></mxCell><mxCell id="gripper.c5" style="edgeStyle=none;rounded=0;html=1;strokeColor=#111111;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="gripper.st0" target="gripper.out2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7594.0" y="2956.5"/><mxPoint x="7594.0" y="3105.5"/></Array></mxGeometry></mxCell><mxCell id="gripper.c6" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9aa5b1;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=0.092;exitY=1.000;exitDx=0;exitDy=0;entryX=0.092;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="gripper.st0" target="gripper.st1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gripper.c7" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9aa5b1;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=0.092;exitY=1.000;exitDx=0;exitDy=0;entryX=0.092;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="gripper.st1" target="gripper.st2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gripper.c8" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9aa5b1;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=0.092;exitY=1.000;exitDx=0;exitDy=0;entryX=0.092;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="gripper.st2" target="gripper.st3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="safety_stop" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7785;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="8084.0" y="2834.0" width="832.0" height="486.0" as="geometry"/></mxCell><mxCell id="safety_stop.head" value="&lt;b style=&quot;font-size:16px&quot;&gt;safety_stop — 정지 노드 (늘 켜 둠)&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dde6f7;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=72;" vertex="1" parent="1"><mxGeometry x="8084.0" y="2834.0" width="832.0" height="50.0" as="geometry"/></mxCell><mxCell id="safety_stop.badge" value="&lt;b&gt;노드&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="8094.0" y="2846.0" width="52.0" height="24.0" as="geometry"/></mxCell><mxCell id="safety_stop.meta" value="로봇 동작 · 패키지 d2_robot/d2_safety&lt;br&gt;&lt;b&gt;&lt;span style=&quot;color:#5566b5&quot;&gt;돌리는 곳: 호스트&lt;/span&gt;&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="8556.0" y="2838.0" width="350.0" height="42.0" as="geometry"/></mxCell><mxCell id="safety_stop.col10" value="&lt;b&gt;입력 — 받는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="8094.0" y="2888.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="safety_stop.col266" value="&lt;b&gt;처리 — 하는 일(번호 순)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="8350.0" y="2888.0" width="300.0" height="22.0" as="geometry"/></mxCell><mxCell id="safety_stop.col612" value="&lt;b&gt;출력 — 내보내는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="8696.0" y="2888.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="safety_stop.in0" value="&lt;b&gt;/d2/safety/stop (서비스 받음)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;source web(화면 정지 — 브리지 경유) · voice(음성 &#x27;정지&#x27; — 생성 칸 마이크 · [말로 정지], E-105 · #171) · task(시간 초과 TIMEOUT · Ctrl+C CTRL_C · 예외 = STOP_TASK)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="8094.0" y="2914.0" width="210.0" height="113.0" as="geometry"/></mxCell><mxCell id="safety_stop.in1" value="&lt;b&gt;로봇 알람 ← bringup · 이 터미널 Ctrl+C&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;0.5 s 마다 두산 get_robot_state → 알람(SAFE_OFF · SAFE_STOP · EMERGENCY_STOP …)이면 정지 · 정지 노드 터미널 Ctrl+C (그리퍼 응답 없음 · ERROR는 작업 관리자 — E-74)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="8094.0" y="3037.0" width="210.0" height="128.0" as="geometry"/></mxCell><mxCell id="safety_stop.in2" value="&lt;b&gt;/d2/safety/resume (서비스 받음)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;화면 [다시 시작] · [정리 끝](E-98) — 브리지 경유&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="8094.0" y="3175.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="safety_stop.in3" value="&lt;b&gt;/joint_states&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;지금 관절값 · 섰는지&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="8094.0" y="3257.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="safety_stop.out0" value="&lt;b&gt;/dsr_moveit_controller/joint_trajectory (토픽) → 제어기&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;제어기에 직접 · 예비 move_stop&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="8696.0" y="2914.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="safety_stop.out1" value="&lt;b&gt;/d2/safety/state (토픽)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;멈춤 · 잠금 · 이유 → 모두 · 브리지&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="8696.0" y="2982.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="safety_stop.out2" value="&lt;b&gt;stop · resume 응답 → bridge (ROS)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;success · message&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="8696.0" y="3049.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="safety_stop.st0" value="① 멈출지 판단 — 잠금 · 이유 방송은 여기 한 곳(세우기 자체는 pick_place 도 같은 SafeStop) · 브리지 · 브로커가 죽어도 Ctrl+C · 펜던트는 그대로" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="8350.0" y="2914.0" width="300.0" height="70.0" as="geometry"/></mxCell><mxCell id="safety_stop.st1" value="② safety/state {stopped, locked, reason} 먼저 방송(바뀔 때만 · TRANSIENT_LOCAL — 집기·놓기가 보고 다음 궤적을 안 보내게) — reason = STOP_WEB · STOP_VOICE · STOP_TASK · TIMEOUT · CTRL_C · ROBOT_ALARM:&lt;상태&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="8350.0" y="2994.0" width="300.0" height="100.0" as="geometry"/></mxCell><mxCell id="safety_stop.st2" value="③ 서기 궤적(지금 자리 0.3 s) → 토픽 /dsr_moveit_controller/joint_trajectory로 제어기에 직접(액션 아님)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="8350.0" y="3104.0" width="300.0" height="55.0" as="geometry"/></mxCell><mxCell id="safety_stop.st3" value="④ 2 s 안에 안 서면 move_stop" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="8350.0" y="3169.0" width="300.0" height="25.0" as="geometry"/></mxCell><mxCell id="safety_stop.st4" value="⑤ 잠금 → 다시 시작(resume)으로만 풀림 → 작업 관리자가 진행 확인부터" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="8350.0" y="3204.0" width="300.0" height="40.0" as="geometry"/></mxCell><mxCell id="safety_stop.c0" style="edgeStyle=none;rounded=0;html=1;strokeColor=#e00000;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.171;entryDx=0;entryDy=0;" edge="1" parent="1" source="safety_stop.in0" target="safety_stop.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="8314.0" y="2970.5"/><mxPoint x="8314.0" y="2926.0"/></Array></mxGeometry></mxCell><mxCell id="safety_stop.c1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#e00000;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.171;entryDx=0;entryDy=0