eometry"/></mxCell><mxCell id="backend.in10" value="&lt;b&gt;MQTT d2/bridge/alive&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;1초 · 3초 끊기면 &#x27;로봇 PC 연결 끊김&#x27;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1462.0" y="1460.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="backend.in11" value="&lt;b&gt;MQTT d2/vision/scan_preview · scan_preview_cloud&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;JSON + PLY(capture ≤ 2 MB · live ≤ 500 KB) — 스캔 중 점군(E-82)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1462.0" y="1527.0" width="210.0" height="86.0" as="geometry"/></mxCell><mxCell id="backend.out0" value="&lt;b&gt;MQTT d2/hmi/command/req&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;select_design · start · scan · cancel · gripper_open&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2264.0" y="686.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="backend.out1" value="&lt;b&gt;MQTT d2/safety/stop/req · resume/req&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;정지 · 다시 시작 버튼&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2264.0" y="753.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="backend.out2" value="&lt;b&gt;MQTT d2/hmi/voice/listen&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;voice_listen/1 — 한 번 듣기(웹 PC 안)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2264.0" y="821.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="backend.out3" value="&lt;b&gt;MQTT d2/task/check_design/req&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;parts/4.0 + base_recipe (+ 스캔 저장만 made_by &quot;scan&quot;)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2264.0" y="888.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="backend.out4" value="&lt;b&gt;HTTP → claude_bridge :8790&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;OpenAI 형식 /v1/chat/completions(D2_LLM_URL) — 키 없음&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2264.0" y="970.0" width="210.0" height="71.0" as="geometry"/></mxCell><mxCell id="backend.out5" value="&lt;b&gt;MQTT get_design/res · save_build/res&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;design/4.0 / ok · retry&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2264.0" y="1051.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="backend.out6" value="&lt;b&gt;저장소 읽기 · 쓰기&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;PostgreSQL db(DATABASE_URL) · 비면 JSON 파일 /data&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2264.0" y="1119.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="backend.out7" value="&lt;b&gt;MQTT d2/web/alive&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;1초 (LWT)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2264.0" y="1186.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="backend.out8" value="&lt;b&gt;WebSocket /ws → frontend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;상태 · 진행표 · 알림 · 연결 · 음성 문장 · 생성 · 스캔 저장 진행&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2264.0" y="1239.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="backend.out9" value="&lt;b&gt;REST 응답 → frontend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;목록 · 상세 · 생성 결과 · 추천 · 명령 결과 · 사진 · 점군 · 손목 영상&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="2264.0" y="1306.0" width="210.0" height="71.0" as="geometry"/></mxCell><mxCell id="backend.st0" value="① REST 명령 → MQTT d2/hmi/command/req(select_design · start · scan · cancel · gripper_open) · d2/safety/stop · resume/req → …/res를 REST 답으로(5초 · 자동 재전송 없음)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1718.0" y="710.0" width="500.0" height="55.0" as="geometry"/></mxCell><mxCell id="backend.st1" value="② retained 상태 5개 · 음성 문장 · 다리 연결 신호를 /ws로 밀어 줌 · 웹 연결 신호 d2/web/alive 1초(LWT)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1718.0" y="775.0" width="500.0" height="40.0" as="geometry"/></mxCell><mxCell id="backend.st2" value="③ 바이트(손목 영상 · 스캔 사진 · 점군 · 점군 미리보기 capture · live)는 마지막 1장만 들고 /ws에는 번호만 → REST(wrist.jpg · scan_cloud.ply · scan_preview.ply)로 내줌 · frontend/out 정적 서빙 · robot.yaml 설계 규칙 읽기 전용(E-78)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1718.0" y="825.0" width="500.0" height="70.0" as="geometry"/></mxCell><mxCell id="backend.st3" value="④ 마이크 버튼 · 로봇 패널 [말로 정지] /api/voice/listen → MQTT d2/hmi/voice/listen(voice_listen/1 — 웹 PC 안만, 다리 안 거침 · retained 아님)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1718.0" y="905.0" width="500.0" height="55.0" as="geometry"/></mxCell><mxCell id="backend.st4" value="⑤ generate(text, design_id): 고른 설계 = 부모 · 같은 Template 다른 설계는 목록으로(도구 get_design 참고 읽기 — 첫 차례 required · 읽거나 SKIP, 그다음 auto, E-72 10/14 고침) · 요청 글에 [Template 규칙] · 음성이면 made_by voice + 확신도(못 알아들으면 VOICE_UNCLEAR, E-118) · 생성 전체 5분 상한(W108) → Claude(opus · 한 번 260초 · 시간 초과 · 한도면 다시 안 함, 까닭을 화면에)가 후보 3개 parts/4.0(위치 · 방향 · 역할 · 그룹 · 순서 sequence · 단계 · 잡기)을 직접 씀" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1718.0" y="1004.0" width="500.0" height="115.0" as="geometry"/></mxCell><mxCell id="backend.st5" value="⑥ 후보마다 새 ID → 연짝(같은 층 긴 면 맞댄 눕힌 블록) 잡기를 FLAT_LONG으로 맞춤(E-104 ③ — row_grasp.row_orders + 검사 손가락 규칙, 들어가는 블록만) → check_design/req(+ base_recipe = Template V000 레시피, 21번) → 통과만 남기고 모자란 만큼 다시(처음 + 2) · REQUEST_INVALID는 다시 안 만듦 · 실패 kind로 화면 문구 → 사람이 1개 고름 → 저장(안 고른 후보는 버림)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1718.0" y="1129.0" width="500.0" height="85.0" as="geometry"/></mxCell><mxCell id="backend.st6" value="⑦ 스캔 [그대로 저장]: scan_fill — AI가 역할 · 그룹 · 순서 · 잡기 + 부모 고르기(E-79) → 연짝 FLAT_LONG 맞춤 → 검사(made_by &quot;scan&quot; — 21번 Template 건너뜀, E-106) → AI 칸 탓이면 다시 채움(최대 2번) → 저장(made_by scan) · 추천 설계 match_scan(일치율 상위 3, E-97)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1718.0" y="1224.0" width="500.0" height="70.0" as="geometry"/></mxCell><mxCell id="backend.st7" value="⑧ 설계 designs/&lt;id&gt;.json(design/4.0) · 조립 기록 builds · AI 호출 기록 gen_logs(NFR-17) — PostgreSQL db(W088 — 표시 이름 display_name · 이름 바꾸기 PUT /api/designs/{id}/name → gen_logs rename · 저장 실패 까닭은 backend 로그, E-115) 또는 JSON 파일 폴더 /data. 기본 설계 4개(_V000)는 켤 때 레시피 → 변환기 ② → 같은 ID로 다시 등록(덮어씀 · 검사 안 부름 — 레시피 PR CI) · 이름 &lt;Template&gt;_V&lt;3자리&gt;(E-84) · 저장한 설계는 고치지 않음" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1718.0" y="1338.0" width="500.0" height="115.0" as="geometry"/></mxCell><mxCell id="backend.st8" value="⑨ get_design/req → design/4.0 답 · save_build/req → builds(같은 run_id 한 번만 · 형식이 틀리면 retry false 영구 거절)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1718.0" y="1463.0" width="500.0" height="40.0" as="geometry"/></mxCell><mxCell id="backend.c0" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1f4fd6;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.218;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend.in0" target="backend.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1682.0" y="735.5"/><mxPoint x="1682.0" y="722.0"/></Array></mxGeometry></mxCell><mxCell id="backend.c1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1f4fd6;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.327;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend.in0" target="backend.st3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1682.0" y="735.5"/><mxPoint x="1682.0" y="923.0"/></Array></mxGeometry></mxCell><mxCell id="backend.c2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1f4fd6;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.209;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend.in0" target="backend.st4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1682.0" y="735.5"/><mxPoint x="1682.0" y="1028.0"/></Array></mxGeometry></mxCell><mxCell id="backend.c3" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1f4fd6;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.429;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend.in0" target="backend.st6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1682.0" y="735.5"/><mxPoint x="1682.0" y="1254.0"/></Array></mxGeometry></mxCell><mxCell id="backend.c4" style="edgeStyle=none;rounded=0;html=1;strok