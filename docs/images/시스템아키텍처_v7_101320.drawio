<mxfile host="app.diagrams.net"><diagram name="아키텍처 v7" id="d2arch7"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="9076" pageHeight="5601"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;AI가 설계하고 로봇이 조립하는 젠가 가구 — 시스템 아키텍처 v7 (10/15 9차 통합 기준 — main 2d74462 + W201 검사기 연결 · A4 #182 · 점선(예정) 없음) · 웹 PC = 한석형 PC(ROS 없음: frontend Next.js 정적 + three.js · backend FastAPI :8000 · 설계 AI Claude 중계 · 저장 PostgreSQL(비면 JSON 파일) · 음성 voice.py) + 로봇 PC = 박진용 PC(ROS 노드 전부 + 다리) · 컨테이너 3개(mosquitto · web · db) · PC 사이 MQTT(Wi-Fi)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40.0" y="14.0" width="8956.0" height="40.0" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b7c1cc;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30.0" y="60.0" width="8976.0" height="430.0" as="geometry"/></mxCell><mxCell id="leg1t" value="&lt;b&gt;① 화살표 색 = 데이터 갈래&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50.0" y="70.0" width="500.0" height="28.0" as="geometry"/></mxCell><mxCell id="leg1e0" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#1f4fd6;strokeWidth=3.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="120.0" as="sourcePoint"/><mxPoint x="150.0" y="120.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l0" value="명령 — 화면 버튼 · 마이크 → 작업 관리자 · 음성" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="107.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg1e1" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#a020c0;strokeWidth=3.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660.0" y="120.0" as="sourcePoint"/><mxPoint x="750.0" y="120.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l1" value="표시 — 작업 관리자 · 정지 · 그리퍼 상태 → 화면" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="764.0" y="107.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg1e2" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#e08a00;strokeWidth=3.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260.0" y="120.0" as="sourcePoint"/><mxPoint x="1350.0" y="120.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l2" value="설계 — AI 생성(Claude) · 검사(check_design) · 꺼내기(get_design) · 저장(설계 · 조립 기록)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1364.0" y="107.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg1e3" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#1e9e3e;strokeWidth=3.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="154.0" as="sourcePoint"/><mxPoint x="150.0" y="154.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l3" value="관측 · 스캔 · 진행표 — 배치 확인 · 흩어진 블록 찾기 · 스캔 · 손목 영상 · 점군" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="141.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg1e4" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#111111;strokeWidth=3.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660.0" y="154.0" as="sourcePoint"/><mxPoint x="750.0" y="154.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l4" value="동작 — 작업 관리자 → 집기·놓기 → 그리퍼 · 장면 · MoveIt2" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="764.0" y="141.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg1e5" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#e00000;strokeWidth=3.8000000000000003;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260.0" y="154.0" as="sourcePoint"/><mxPoint x="1350.0" y="154.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l5" value="정지 — 정지 버튼 · 시간 초과(task) → 정지 노드 → 모두 · 제어기" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1364.0" y="141.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg1e6" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#a8a8a8;strokeWidth=2.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="188.0" as="sourcePoint"/><mxPoint x="150.0" y="188.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg1l6" value="장치 · 바깥 · 연결 신호 — USB · 제어기 · 드라이버 · Claude · OpenAI 받아 적기 · alive" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="175.0" width="480.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg2t" value="&lt;b&gt;② 선 모양&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50.0" y="204.0" width="300.0" height="28.0" as="geometry"/></mxCell><mxCell id="leg2a" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#333333;strokeWidth=2.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="254.0" as="sourcePoint"/><mxPoint x="150.0" y="254.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg2al" value="실선 = 지금 main에 있는 연결(10/15 main 2d74462 코드 그대로 — 기본 꺼짐도 main에 있으면 실선 + 글 &#x27;기본 꺼짐&#x27;)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="241.0" width="900.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg2b" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#333333;strokeWidth=2.4;dashed=1;dashPattern=8 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="288.0" as="sourcePoint"/><mxPoint x="150.0" y="288.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg2bl" value="점선 = 예정 — 정했지만 아직 main에 없는 연결 · 상자 · 처리(10/15 9차 기준 — 지금 없음)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="275.0" width="1100.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg2v" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=2.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="308.0" as="sourcePoint"/><mxPoint x="105.0" y="352.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg2h" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#1f4fd6;strokeWidth=2.4;jumpStyle=arc;jumpSize=14;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="330.0" as="sourcePoint"/><mxPoint x="150.0" y="330.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg2hl" value="다리 = 선이 겹치는 곳(서로 이어진 게 아님)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="317.0" width="900.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg2i" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#1e9e3e;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="370.0" as="sourcePoint"/><mxPoint x="120.0" y="386.0" as="targetPoint"/><Array as="points"><mxPoint x="90.0" y="370.0"/><mxPoint x="90.0" y="386.0"/></Array></mxGeometry></mxCell><mxCell id="leg2il" value="카드 안 가는 선 = 입력이 어느 처리로 가고, 어느 처리가 출력을 내는지(색 = 들어온 화살표 색)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="164.0" y="364.0" width="1100.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3t" value="&lt;b&gt;③ 상자 종류&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1290.0" y="204.0" width="300.0" height="28.0" as="geometry"/></mxCell><mxCell id="leg3b0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a94a0;" vertex="1" parent="1"><mxGeometry x="1300.0" y="244.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l0" value="노드 카드 — 우리가 만드는 노드 (머리띠 색 = 파트)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="242.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3b1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3e7ec;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1300.0" y="274.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l1" value="이미 있는 노드 — 설치해서 씀" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="272.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3b2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#666666;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1300.0" y="304.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l2" value="예정 — 정했지만 main에 없음(노드 · 저장소 · 입출력 · 처리)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="302.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3b3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1300.0" y="334.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l3" value="저장소(DB) · 라이브러리(노드 아님)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="332.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3b4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1300.0" y="364.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l4" value="장치 — 노드 아님(하드웨어)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="362.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3b5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1565c0;dashed=1;dashPattern=8 5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1300.0" y="394.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l5" value="컨테이너(Docker) — 안의 노드가 이 상자에서 돈다" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="392.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg3b6" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;" vertex="1" parent="1"><mxGeometry x="1300.0" y="424.0" width="70.0" height="22.0" as="geometry"/></mxCell><mxCell id="leg3l6" value="클래스 — 노드 안의 코드 묶음" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1382.0" y="422.0" width="700.0" height="26.0" as="geometry"/></mxCell><mxCell id="leg4t" value="&lt;b&gt;④ 낱말&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2190.0" y="70.0" width="300.0" height="28.0" as="geometry"/></mxCell><mxCell id="leg4_0" value="&lt;b&gt;노드&lt;/b&gt;&amp;nbsp;&amp;nbsp; 실행되는 프로그램 하나(ROS 2 노드). ros2 run으로 켠다. 이 그림의 카드 하나(웹 쪽 카드는 ROS 아닌 프로그램)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="104.0" width="2600.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_1" value="&lt;b&gt;패키지&lt;/b&gt;&amp;nbsp;&amp;nbsp; 노드들을 담은 폴더(d2_task · d2_vision · d2_bridge …). 로봇 패키지 4개는 src/d2_robot/ 아래(d2_bringup · d2_motion · d2_gripper · d2_safety). 웹 코드는 web/(ROS 아님). 카드 오른쪽 위 글자" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="142.0" width="2600.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_2" value="&lt;b&gt;클래스&lt;/b&gt;&amp;nbsp;&amp;nbsp; 노드 안의 코드 묶음. task의 TaskManager · TaskPlanner · BlockPicker · PickRanker · ScatterFlow · DesignChecker · TemplateChecker · RunLogger, 손목 비전의 BlockChecker · BlockFinder · StructureScanner, web의 DesignGenerator · DesignStore · MqttClient, bridge의 MqttBridge" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="180.0" width="2600.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_3" value="&lt;b&gt;컨테이너&lt;/b&gt;&amp;nbsp;&amp;nbsp; Docker 상자(웹 PC compose). 지금 mosquitto · web · db(PostgreSQL — 프로필, W088) 3개" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="218.0" width="2600.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_4" value="&lt;b&gt;MQTT · 다리&lt;/b&gt;&amp;nbsp;&amp;nbsp; PC 사이 통신(Wi-Fi). 웹 PC 브로커(mosquitto) ↔ 로봇 PC 다리(bridge)가 ROS ↔ MQTT를 바꾼다. 토픽 d2/…, 요청 …/req · 응답 …/res + req_id, 상태 retained, 연결 신호 alive" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="256.0" width="2600.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_5" value="&lt;b&gt;부품 JSON · 레시피&lt;/b&gt;&amp;nbsp;&amp;nbsp; 설계를 부품 목록으로 적은 것 — parts/4.0(위치 · 방향 + 역할 · 그룹 · 순서 sequence · 단계 · 잡기 — AI · 스캔 저장) · blocks/2(진짜 블록 위치 · 방향만, 스캔 추론) / 로봇이 쌓는 조립도 = &lt;설계 ID&gt;_recipe.json(recipe/4.0: 맨 위 design_id · stocks + template.composition) + &lt;설계 ID&gt;_placements.csv(placements/4.0: 순서 · 잡기 · 받침). 부품 이름 part_id = &lt;설계 ID&gt;_&lt;역할&gt;_&lt;그룹&gt;_&lt;부품&gt;(E-94). 변환기 ①②③이 바꾼다" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="294.0" width="2600.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_6" value="&lt;b&gt;토픽&lt;/b&gt;&amp;nbsp;&amp;nbsp; 방송 — 보내고 끝, 답 없음. 여러 곳이 계속 봐야 하는 상태 · 진행표" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="332.0" width="2600.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_7" value="&lt;b&gt;서비스&lt;/b&gt;&amp;nbsp;&amp;nbsp; 부탁 → 답 한 번. 짧은 일(명령 · 확인 · 그리퍼). JSON을 주고받는 서비스는 JsonQuery 하나(check_design · get_design · save_build · scan_capture · scan_infer · find_blocks)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="370.0" width="2600.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4_8" value="&lt;b&gt;액션&lt;/b&gt;&amp;nbsp;&amp;nbsp; 부탁 → 중간 보고 → 결과, 도중 취소 가능. 부품 1개 옮기기(pick_place)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="408.0" width="2600.0" height="30.0" as="geometry"/></mxCell><mxCell id="leg4n" value="서비스 · 액션 화살표는 부탁하는 방향으로만 그렸다. 답은 같은 길로 돌아온다." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="2200.0" y="446.0" width="1200.0" height="30.0" as="geometry"/></mxCell><mxCell id="layer_svc" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fbf3ea;strokeColor=#b36b00;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="30.0" y="520.0" width="8976.0" height="1462.0" as="geometry"/></mxCell><mxCell id="layer_svc_t" value="&lt;b&gt;웹 PC = 한석형 PC — ROS 2 없음 · compose 컨테이너 3개(mosquitto 1883 / web = backend FastAPI :8000 + frontend 정적 / db PostgreSQL) + 호스트 claude_bridge :8790 · voice.py · 화면은 이 PC 브라우저 localhost:8000 · 로봇 PC와 MQTT(Wi-Fi — 로봇 PC만 허용)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b36b00;strokeColor=none;fontColor=#ffffff;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30.0" y="520.0" width="2568.8" height="38.0" as="geometry"/></mxCell><mxCell id="layer_robot" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#eef1fb;strokeColor=#3b5bb5;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="30.0" y="2436.0" width="8976.0" height="2722.0" as="geometry"/></mxCell><mxCell id="layer_robot_t" value="&lt;b&gt;로봇 PC = 박진용 PC — ROS 2 노드 전부, 컨테이너 없이 호스트 · CycloneDDS(ROS_DOMAIN_ID 60)는 이 PC 안에서만 · 다리(bridge)가 MQTT ↔ ROS 변환 · 제어기 · 그리퍼와 유선 · 손목 카메라 USB 3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b5bb5;strokeColor=none;fontColor=#ffffff;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30.0" y="2436.0" width="2100.0" height="38.0" as="geometry"/></mxCell><mxCell id="layer_dev" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ecf6f0;strokeColor=#2e8b7a;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="30.0" y="5360.0" width="8976.0" height="171.0" as="geometry"/></mxCell><mxCell id="layer_dev_t" value="&lt;b&gt;로봇 · 장치 · 바깥 서비스 (노드 아님)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e8b7a;strokeColor=none;fontColor=#ffffff;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30.0" y="5360.0" width="2100.0" height="38.0" as="geometry"/></mxCell><mxCell id="ctr_web" value="&lt;b&gt;[Docker] web — 컨테이너 하나 = backend(FastAPI :8000) 한 프로세스 + 저장소 파일 /data(볼륨). frontend는 정적 out/로 담겨 브라우저에서 실행(Node 없음) · 화면 포트는 127.0.0.1:8000만&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#1565c0;strokeWidth=2.5;dashed=1;dashPattern=8 5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=13;fontColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="168.0" y="572.0" width="3028.0" height="1077.0" as="geometry"/></mxCell><mxCell id="ctr_mqtt" value="&lt;b&gt;[Docker] mosquitto — MQTT 브로커 1883 · 웹 PC Wi-Fi IP에만 공개&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#1565c0;strokeWidth=2.5;dashed=1;dashPattern=8 5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=13;fontColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="6068.0" y="572.0" width="956.0" height="609.0" as="geometry"/></mxCell><mxCell id="ctr_db" value="&lt;b&gt;[Docker] db — PostgreSQL 16 · 프로필 db · 포트 안 엶&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#1565c0;strokeWidth=2.5;dashed=1;dashPattern=8 5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=13;fontColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="7427.3" y="572.0" width="996.0" height="653.0" as="geometry"/></mxCell><mxCell id="files" value="&lt;b&gt;[저장소] 저장소 파일 /data — JSON 폴더 (web 컨테이너 볼륨 backend/data)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;designs/&lt;id&gt;.json(design/4.0) · builds · gen_logs · .env DATABASE_URL이 비면 여기(되돌리기용), 채우면 db(W088)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2794.0" y="606.0" width="380.0" height="100.0" as="geometry"/></mxCell><mxCell id="devops" value="&lt;b&gt;[개발 도구] Docker compose · GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;compose = 컨테이너 3개(mosquitto · web · db — db는 프로필) — WEB_UID · WEB_GID · D2_WEB_IPV4 필요 · CI = pytest(tests · d2_task · d2_vision — tests/test_shared_tables = 공용 표 정본 · 복사본 같은지, E-111) · colcon · ruff(토큰 없음) + PR 검사 · Claude 검토 → 자동 승인 · 실행 구성 아님 · 화살표 없음&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f0ff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="6090.0" y="1855.0" width="640.0" height="97.0" as="geometry"/></mxCell><mxCell id="recipe_tool" value="&lt;b&gt;[라이브러리] 레시피 도구 — CAD → 레시피 두 파일&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;src/recipe_manager(빌드 밖 · 사람이 돌림, 한세교) · cads/ → &lt;설계 ID&gt;_recipe.json(recipe/4.0 — 맨 위 design_id · source_cad · stocks + template.composition) + &lt;설계 ID&gt;_placements.csv(placements/4.0 · sequence · recipe_sha256 · 연짝 = FLAT_LONG E-104) · 기본 설계 4개 001_CHAIR_BENCH · 002_CHAIR_BACK · 003_DESK_STAND · 004_DESK_PEDESTAL(_V000 = Template 정의 겸함) · 변환기 ① ②는 d2_task 안&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f0ff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1372.0" y="5031.0" width="720.0" height="97.0" as="geometry"/></mxCell><mxCell id="devtools" value="&lt;b&gt;[개발 도구] 개발 · 시험 도구 (실행 구성 아님)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;mock_robot.py(웹 — 로봇 없이 화면 · 진행표 = 진짜 TaskPlanner · 검사 = 진짜 검사 묶음) · mock_bridge(다리 자리 가짜) · mock_wrist_block(카메라 없이) · run_recipe(레시피 바로 쌓기) · capture_scene(촬영 저장) · check_wrist_calib(손목 보정 확인)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f0ff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2674.0" y="5031.0" width="700.0" height="82.0" as="geometry"/></mxCell><mxCell id="realsense" value="&lt;b&gt;[이미 있는 노드] realsense2_camera — 손목 카메라 드라이버&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;설치해서 씀 · rs_launch.py · 컬러 · 정렬 깊이 · camera_info → wrist_block · scan_live_preview&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3e7ec;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3816.0" y="5031.0" width="480.0" height="74.0" as="geometry"/></mxCell><mxCell id="bringup" value="&lt;b&gt;[이미 있는 노드] 브링업 — 이미 있는 노드들: 두산 드라이버 · dsr_moveit_controller · MoveIt2 move_group · OnRobot RG2 드라이버(onrobot_rg_control)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;real_moveit.launch.py(설치한 것을 띄움 — 우리가 만들지 않음 · IK = kinematics.yaml KDL 50 ms) · 우리 노드 4개는 robot_nodes.launch.py(safety_stop · gripper · scene_manager · pick_place), task · wrist_block · bridge는 따로 실행 · robot.yaml(측정값 정본, d2_robot/d2_bringup/config) · /joint_states · 로봇 알람&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3e7ec;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="4868.0" y="5031.0" width="4048.0" height="74.0" as="geometry"/></mxCell><mxCell id="dev_person" value="&lt;b&gt;[장치] 사람 — 웹 PC 브라우저 · 로봇 PC 터미널(Ctrl+C) · 펜던트&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;펜던트 비상정지는 늘 작동 · [조립] · [스캔] · [계속] 누르기 전 작업 영역 밖 확인 · 정지 뒤 정리는 사람이 직접(E-98)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190.0" y="5416.0" width="440.0" height="85.0" as="geometry"/></mxCell><mxCell id="anthropic" value="&lt;b&gt;[장치] Claude (Anthropic) — 설계 AI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;인터넷 · 웹 PC에 로그인된 Claude Code(구독 한도) · 키 없음 · 기본 opus · 후보 작성 한 번 31 ~ 165초(10/13 시험)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3621.3" y="5416.0" width="440.0" height="74.0" as="geometry"/></mxCell><mxCell id="openai" value="&lt;b&gt;[장치] OpenAI 받아 적기 API — 음성 → 글&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;인터넷 · gpt-4o-mini-transcribe(안 되면 whisper-1, E-118) · 키는 웹 PC .env · voice.py만 씀 — 설계 AI는 Claude(E-99)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="4840.7" y="5416.0" width="400.0" height="82.0" as="geometry"/></mxCell><mxCell id="dev_mic" value="&lt;b&gt;[장치] 마이크 · 스피커&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;웹 PC USB — 호스트 voice.py(녹음 · 삑)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="5280.7" y="5416.0" width="240.0" height="74.0" as="geometry"/></mxCell><mxCell id="dev_d435" value="&lt;b&gt;[장치] 손목 카메라 D435i (깊이)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;로봇 PC USB 3 · 배치 확인 · 흩어진 블록 찾기 · 스캔&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="4101.3" y="5416.0" width="320.0" height="74.0" as="geometry"/></mxCell><mxCell id="dev_ctrl" value="&lt;b&gt;[장치] M0609 제어기 (DRCF)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;두산 일반 모드(E-48) · 유선 · 안전 설정: TCP 속도 · 충돌 감지&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="6682.0" y="5416.0" width="420.0" height="74.0" as="geometry"/></mxCell><mxCell id="dev_rg2" value="&lt;b&gt;[장치] OnRobot RG2 그리퍼&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;힘 10 N · 최대 110 mm · Modbus TCP(드라이버)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="7142.0" y="5416.0" width="300.0" height="74.0" as="geometry"/></mxCell><mxCell id="frontend" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7785;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190.0" y="606.0" width="1012.0" height="614.0" as="geometry"/></mxCell><mxCell id="frontend.head" value="&lt;b style=&quot;font-size:16px&quot;&gt;frontend — 화면 (브라우저 실행 · Next.js 16 정적 + React 19 + three.js)&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fde9d9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=72;" vertex="1" parent="1"><mxGeometry x="190.0" y="606.0" width="1012.0" height="50.0" as="geometry"/></mxCell><mxCell id="frontend.badge" value="&lt;b&gt;노드&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200.0" y="618.0" width="52.0" height="24.0" as="geometry"/></mxCell><mxCell id="frontend.meta" value="HMI · 패키지 web/frontend&lt;br&gt;&lt;b&gt;&lt;span style=&quot;color:#1565c0&quot;&gt;돌리는 곳: 컨테이너 web&lt;/span&gt;&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="842.0" y="610.0" width="350.0" height="42.0" as="geometry"/></mxCell><mxCell id="frontend.col10" value="&lt;b&gt;입력 — 받는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="200.0" y="660.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="frontend.col266" value="&lt;b&gt;처리 — 하는 일(번호 순)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="456.0" y="660.0" width="480.0" height="22.0" as="geometry"/></mxCell><mxCell id="frontend.col792" value="&lt;b&gt;출력 — 내보내는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="982.0" y="660.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="frontend.grp0" value="&lt;b&gt;React 컴포넌트 11개(+ 꾸밈 ThemeToggle · CountUp) · lib/api.ts · lib/ws.ts&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="450.0" y="686.0" width="492.0" height="516.0" as="geometry"/></mxCell><mxCell id="frontend.in0" value="&lt;b&gt;사람 — 마우스 · 글 창 · 마이크 버튼&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;설계 고르기 · [조립] · [AI 생성] · 마이크 · 후보 고르기 · [스캔] · [계속] · [취소] · 정지 · [말로 정지] · 다시 시작 · [초기화] · [그리퍼 열기] · [정리 끝] · 스캔 [그대로 저장] · [다시 스캔]&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="200.0" y="686.0" width="210.0" height="128.0" as="geometry"/></mxCell><mxCell id="frontend.in1" value="&lt;b&gt;REST 응답 (backend)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;설계 목록 · 상세 · Template · 규칙 · 생성 · 스캔 저장 작업 · 추천 설계 · 명령 결과 · 점군 · 점군 미리보기 · 손목 영상&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="200.0" y="824.0" width="210.0" height="85.0" as="geometry"/></mxCell><mxCell id="frontend.in2" value="&lt;b&gt;WebSocket /ws (backend)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;state · progress · safety · gripper · scan_result · scan_preview · intent(음성 문장) · gen · scan_save · 연결 · 그림 번호&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="200.0" y="919.0" width="210.0" height="99.0" as="geometry"/></mxCell><mxCell id="frontend.out0" value="&lt;b&gt;REST 요청 → backend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;/api/designs/* · /api/robot/* · /api/voice/listen(생성 칸 마이크 · [말로 정지]) (HTTP :8000 — 웹 PC localhost)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="982.0" y="686.0" width="210.0" height="85.0" as="geometry"/></mxCell><mxCell id="frontend.out1" value="&lt;b&gt;사람 — 화면&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;설계 3D · 후보 · 검사 결과 · 진행도 · 알림 · 스캔 점군 · 손목 영상 · 연결 상태&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="982.0" y="781.0" width="210.0" height="71.0" as="geometry"/></mxCell><mxCell id="frontend.st0" value="① 배치(W196): 맨 위 로봇 패널 가로 한 줄 → 손목 카메라 | 설계 3D 반반 → AI 만들기 가로 전체 · 설계 목록(DesignTree 열 보기 — 기본 · AI · 스캔 설계 전부, 가구 → 기본 → 파생) → 고른 설계 3D(DesignView · Preview3D — parts/4.0 상자, E-40)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="456.0" y="710.0" width="480.0" height="70.0" as="geometry"/></mxCell><mxCell id="frontend.st1" value="② 고른 설계 아래 [조립] 한 번 = select_design → 이어서 start(READY면 start만 — 누름 = 출발 확인 SR-09, E-96) · 로봇 패널(RobotPanel): 상태 · 정지 · 다시 시작 · [스캔] · [계속] · [취소] · 그리퍼 · [말로 정지(듣기 시작)] = /api/voice/listen 한 번(&#x27;정지&#x27;를 들으면 voice.py가 정지 요청 · 다른 말은 안 씀 · 20초, W046) — 멈춘 뒤 [초기화](cancel → 블록 치우기 → [정리 끝] = resume) · [그리퍼 열기](gripper_open — 잠김 + 쥐고 있을 때만, E-98) · [초기화] 안내(그리퍼 · 조립 자리 · 받침 위 블록) · 그리퍼 여는 중 · 끝 글 표시(W184) · 버튼 하나 = REST 하나, 자동 재전송 없음" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="456.0" y="790.0" width="480.0" height="145.0" as="geometry"/></mxCell><mxCell id="frontend.st2" value="③ AI 생성(GeneratePanel): 고른 설계 = 부모 · 글 창 [AI 생성] 또는 마이크 버튼(문장이 /ws로 오면 글 창에 넣고 바로 생성 · 20초 안 오면 안내) → 생성 진행 → 통과 후보 3D + 검사 결과 → 1개 고름 → 저장" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="456.0" y="945.0" width="480.0" height="55.0" as="geometry"/></mxCell><mxCell id="frontend.st3" value="④ 스캔 칸(ScanReview): 스캔 중 점군 미리보기(live가 오면 그것, 아니면 자세마다 모은 capture — CloudView, E-82) → 결과 확인 SCAN_REVIEW에서 최종 점군 + 추론 설계(실물 사진은 안 보임 — 10/13 16시 PL) → [그대로 저장] · [다시 스캔] · [취소] · 추천 설계(ScanRecommend — 일치율 1등, 90 % 미만 경고) [조립]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="456.0" y="1010.0" width="480.0" height="85.0" as="geometry"/></mxCell><mxCell id="frontend.st4" value="⑤ /ws로 받은 상태 · 진행도(ProgressTop) · 알림(공급 · no_match_block · tilted_block · 웹 끊김 · 정지 · ERROR 글 — &#x27;스캔 실패&#x27; · &#x27;다시 스캔하세요&#x27; 포함) · 손목 검출 영상(WristCamera — 확대 ×1 ~ ×3 · 전체 화면 · 윤곽 색 · 글자 풀이) · 연결 표시(ConnectionBadge — 다리 끊기면 [조립] · [스캔] 막음)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="456.0" y="1105.0" width="480.0" height="85.0" as="geometry"/></mxCell><mxCell id="frontend.c0" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.171;entryDx=0;entryDy=0;" edge="1" parent="1" source="frontend.in0" target="frontend.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420.0" y="750.0"/><mxPoint x="420.0" y="722.0"/></Array></mxGeometry></mxCell><mxCell id="frontend.c1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.124;entryDx=0;entryDy=0;" edge="1" parent="1" source="frontend.in0" target="frontend.st1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420.0" y="750.0"/><mxPoint x="420.0" y="808.0"/></Array></mxGeometry></mxCell><mxCell id="frontend.c2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.436;entryDx=0;entryDy=0;" edge="1" parent="1" source="frontend.in0" target="frontend.st2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420.0" y="750.0"/><mxPoint x="420.0" y="969.0"/></Array></mxGeometry></mxCell><mxCell id="frontend.c3" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.353;entryDx=0;entryDy=0;" edge="1" parent="1" source="frontend.in0" target="frontend.st3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420.0" y="750.0"/><mxPoint x="420.0" y="1040.0"/></Array></mxGeometry></mxCell><mxCell id="frontend.c4" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a020c0;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.171;entryDx=0;entryDy=0;" edge="1" parent="1" source="frontend.in1" target="frontend.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="428.0" y="866.5"/><mxPoint x="428.0" y="722.0"/></Array></mxGeometry></mxCell><mxCell id="frontend.c5" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a020c0;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.