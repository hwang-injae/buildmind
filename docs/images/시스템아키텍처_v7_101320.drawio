"816.5"/></Array></mxGeometry></mxCell><mxCell id="backend" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7785;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1452.0" y="606.0" width="1032.0" height="1027.0" as="geometry"/></mxCell><mxCell id="backend.head" value="&lt;b style=&quot;font-size:16px&quot;&gt;backend — API + AI 생성 + 저장소 (FastAPI :8000 · ROS 아님)&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fde9d9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=72;" vertex="1" parent="1"><mxGeometry x="1452.0" y="606.0" width="1032.0" height="50.0" as="geometry"/></mxCell><mxCell id="backend.badge" value="&lt;b&gt;노드&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1462.0" y="618.0" width="52.0" height="24.0" as="geometry"/></mxCell><mxCell id="backend.meta" value="HMI · 패키지 web/backend&lt;br&gt;&lt;b&gt;&lt;span style=&quot;color:#1565c0&quot;&gt;돌리는 곳: 컨테이너 web&lt;/span&gt;&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2124.0" y="610.0" width="350.0" height="42.0" as="geometry"/></mxCell><mxCell id="backend.col10" value="&lt;b&gt;입력 — 받는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1462.0" y="660.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="backend.col266" value="&lt;b&gt;처리 — 하는 일(번호 순)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1718.0" y="660.0" width="500.0" height="22.0" as="geometry"/></mxCell><mxCell id="backend.col812" value="&lt;b&gt;출력 — 내보내는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="2264.0" y="660.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="backend.grp0" value="&lt;b&gt;app.py(FastAPI) + 클래스 MqttClient — REST · /ws · 정적 서빙 · MQTT(req_id)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="1712.0" y="686.0" width="512.0" height="286.0" as="geometry"/></mxCell><mxCell id="backend.grp1" value="&lt;b&gt;클래스 DesignGenerator — LLM 부르는 한 곳 · 후보 3개 · 검사 · 다시 (ROS 없음)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="1712.0" y="980.0" width="512.0" height="326.0" as="geometry"/></mxCell><mxCell id="backend.grp2" value="&lt;b&gt;클래스 DesignStore · PgDesignStore — 저장 한 곳(PostgreSQL · 비면 JSON)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="1712.0" y="1314.0" width="512.0" height="201.0" as="geometry"/></mxCell><mxCell id="backend.in0" value="&lt;b&gt;REST 요청 (frontend)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;/api/robot/command · stop · resume · /api/designs · generate · pick · scan/save · scan/recommend · /api/voice/listen&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1462.0" y="686.0" width="210.0" height="99.0" as="geometry"/></mxCell><mxCell id="backend.in1" value="&lt;b&gt;MQTT d2/hmi/intent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;voice.py 문장 {request_design, text, confidence} → /ws intent&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1462.0" y="795.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="backend.in2" value="&lt;b&gt;MQTT d2/task/state (retained)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;state/2 — 상태 · 알림 · run_id&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1462.0" y="862.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="backend.in3" value="&lt;b&gt;MQTT d2/task/progress (retained)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;progress/2.0&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1462.0" y="930.0" width="210.0" height="58.0" as="geometry"/></mxCell><mxCell id="backend.in4" value="&lt;b&gt;MQTT d2/task/scan_result (retained)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;scan_result/2.0 → 비교 화면 · 추천 · [그대로 저장]&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1462.0" y="998.0" width="210.0" height="72.0" as="geometry"/></mxCell><mxCell id="backend.in5" value="&lt;b&gt;MQTT d2/safety/state (retained)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;멈춤 · 잠금&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlig