.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend.st6" target="backend.out9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4968.0" y="1334.0"/><mxPoint x="4968.0" y="1411.5"/></Array></mxGeometry></mxCell><mxCell id="backend.c35" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9aa5b1;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=0.048;exitY=1.000;exitDx=0;exitDy=0;entryX=0.048;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend.st4" target="backend.st5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="backend.c36" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9aa5b1;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=0.048;exitY=1.000;exitDx=0;exitDy=0;entryX=0.048;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend.st6" target="backend.st7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="claude_bridge" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7785;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="6360.0" y="606.0" width="832.0" height="465.0" as="geometry"/></mxCell><mxCell id="claude_bridge.head" value="&lt;b style=&quot;font-size:16px&quot;&gt;claude_bridge — 설계 AI 중계 (호스트, ROS 아님)&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fde9d9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=72;" vertex="1" parent="1"><mxGeometry x="6360.0" y="606.0" width="832.0" height="50.0" as="geometry"/></mxCell><mxCell id="claude_bridge.badge" value="&lt;b&gt;노드&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="6370.0" y="618.0" width="52.0" height="24.0" as="geometry"/></mxCell><mxCell id="claude_bridge.meta" value="HMI · 패키지 web/claude_bridge.py&lt;br&gt;&lt;b&gt;&lt;span style=&quot;color:#5566b5&quot;&gt;돌리는 곳: 호스트(웹 PC)&lt;/span&gt;&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="6832.0" y="610.0" width="350.0" height="42.0" as="geometry"/></mxCell><mxCell id="claude_bridge.col10" value="&lt;b&gt;입력 — 받는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="6370.0" y="660.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="claude_bridge.col266" value="&lt;b&gt;처리 — 하는 일(번호 순)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="6626.0" y="660.0" width="300.0" height="22.0" as="geometry"/></mxCell><mxCell id="claude_bridge.col612" value="&lt;b&gt;출력 — 내보내는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="6972.0" y="660.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="claude_bridge.in0" value="&lt;b&gt;HTTP POST /v1/chat/completions ← backend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;web 컨테이너 → host.docker.internal:8790 · OpenAI 형식(키 없음 — 자리값 글자만, 안 봄) · 본문 = messages + json_schema + tools · tool_choice required(생성 첫 차례 — 참고 설계 get_design 읽기 또는 SKIP, E-72 · scan_fill 부모 고르기) / auto(그다음 — 도구 버리고 응답) / none&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="6370.0" y="686.0" width="210.0" height="199.0" as="geometry"/></mxCell><mxCell id="claude_bridge.in1" value="&lt;b&gt;음성 요청 — 오인식 바로잡기(E-118) ← backend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;같은 POST 본문 안: 요청 글 앞에 &quot;[음성 받아 적기 — 오인식 가능, 확신도 n / 모름]&quot; + 시스템 프롬프트 [음성 요청] 절 → Claude가 비슷한 소리의 가구 말로 바로잡아 읽음 · 그래도 모르면 &quot;이렇게 들었어요: …&quot; → backend VOICE_UNCLEAR(다시 말하기)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="6370.0" y="895.0" width="210.0" height="156.0" as="geometry"/></mxCell><mxCell id="claude_bridge.out0" value="&lt;b&gt;claude -p 실행 → Claude&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;웹 PC에 로그인된 Claude Code 계정 — 키 없음 · 구독 한도&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="6972.0" y="686.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="claude_bridge.out1" value="&lt;b&gt;HTTP 응답 → backend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;OpenAI 형식 choices · tool_calls / 실패 HTTP 코드 — 504 시간 초과 · 429 구독 한도(둘은 다시 안 부름) · 502 그 밖 · 400 요청 모양&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="6972.0" y="753.0" width="210.0" height="99.0" as="geometry"/></mxCell><mxCell id="claude_bridge.st0" value="① 요청을 글로 바꿈 — json_schema → --json-schema(구조화 출력) · 도구 required → 도구 인자 스키마로 한 번 물음 · auto · none은 도구를 버리고 응답" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="6626.0" y="686.0" width="300.0" height="70.0" as="geometry"/></mxCell><mxCell id="claude_bridge.st1" value="② claude -p --model opus(기본)를 빈 임시 폴더에서 실행 — 도구 · MCP · 슬래시 명령 없음 · 대화 기록 안 남김 · 한 번 240초 상한(backend 260초보다 먼저 끊고 원인을 돌려줌)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="6626.0" y="766.0" width="300.0" height="85.0" as="geometry"/></mxCell><mxCell id="claude_bridge.st2" value="③ 응답을 OpenAI 형식(choices · tool_calls)으로 돌려줌 · 실패는 HTTP 코드 + 한 줄 · 준비 점검 --check 6항목" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="6626.0" y="861.0" width="300.0" height="55.0" as="geometry"/></mxCell><mxCell id="claude_bridge.c0" style="edgeStyle=none;rounded=0;html=1;strokeColor=#e08a00;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.171;entryDx=0;entryDy=0;" edge="1" parent="1" source="claude_bridge.in0" target="claude_bridge.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="6590.0" y="785.5"/><mxPoint x="6590.0" y="698.0"/></Array></mxGeometry></mxCell><mxCell id="claude_bridge.c1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1f4fd6;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.171;entryDx=0;entryDy=0;" edge="1" parent="1" source="claude_bridge.in1" target="claude_bridge.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="6598.0" y="973.0"/><mxPoint x="6598.0" y="698.0"/></Array></mxGeometry></mxCell><mxCell id="claude_bridge.c2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="claude_bridge.st1" target="claude_bridge.out0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="6936.0" y="808.5"/><mxPoint x="6936.0" y="714.5"/></Array></mxGeometry></mxCell><mxCell id="claude_bridge.c3" style="edgeStyle=none;rounded=0;html=1;strokeColor=#e08a00;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="claude_bridge.st2" target="claude_bridge.out1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="6944.0" y="888.5"/><mxPoint x="6944.0" y="802.5"/></Array></mxGeometry></mxCell><mxCell id="claude_bridge.c4" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9aa5b1;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=0.080;exitY=1.000;exitDx=0;exitDy=0;entryX=0.080;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="claude_bridge.st0" target="claude_bridge.st1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="claude_bridge.c5" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9aa5b1;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=0.080;exitY=1.000;exitDx=0;exitDy=0;entryX=0.080;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="claude_bridge.st1" target="claude_bridge.st2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="voice" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7785;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="7586.0" y="606.0" width="862.0" height="494.0" as="geometry"/></mxCell><mxCell id="voice.head" value="&lt;b style=&quot;font-size:16px&quot;&gt;voice.py — 음성 (웹 PC 호스트 · ROS 아님 · 민범진 #171)&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fde9d9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=72;" vertex="1" parent="1"><mxGeometry x="7586.0" y="606.0" width="862.0" height="50.0" as="geometry"/></mxCell><mxCell id="voice.badge" value="&lt;b&gt;노드&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="7596.0" y="618.0" width="52.0" height="24.0" as="geometry"/></mxCell><mxCell id="voice.meta" value="HMI · 패키지 web/backend/voice.py&lt;br&gt;&lt;b&gt;&lt;span style=&quot;color:#5566b5&quot;&gt;돌리는 곳: 호스트(웹 PC)&lt;/span&gt;&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="8088.0" y="610.0" width="350.0" height="42.0" as="geometry"/></mxCell><mxCell id="voice.col10" value="&lt;b&gt;입력 — 받는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="7596.0" y="660.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="voice.col266" value="&lt;b&gt;처리 — 하는 일(번호 순)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="7852.0" y="660.0" width="330.0" height="22.0" as="geometry"/></mxCell><mxCell id="voice.col642" value="&lt;b&gt;출력 — 내보내는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="8228.0" y="660.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="voice.grp0" value="&lt;b&gt;클래스 VoiceListener · Transcriber · Wake · Vad&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="7846.0" y="686.0" width="342.0" height="396.0" as="geometry"/></mxCell><mxCell id="voice.in0" value="&lt;b&gt;MQTT d2/hmi/voice/listen&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;voice_listen/1 — 생성 칸 마이크 · 로봇 패널 [말로 정지] 한 번 = 한 번 듣기(backend가 냄 · 웹 PC 안 · retained 아님)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="7596.0" y="686.0" width="210.0" height="85.0" as="geometry"/></mxCell><mxCell id="voice.in1" value="&lt;b&gt;마이크 (웹 PC USB)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;16 kHz mono · 80 ms 단위 — 누를 때만 연다&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="7596.0" y="781.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="voice.out0" value="&lt;b&gt;MQTT d2/hmi/intent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;intent/1 {intent: request_design, text, confidence} → backend(/ws → 화면 → 생성: made_by voice + 확신도 → Claude가 오인식 바로잡기) · 브리지 → 작업 관리자(무시)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="8228.0" y="686.0" width="210.0" height="113.0" as="geometry"/></mxCell><mxCell id="voice.out1" value="&lt;b&gt;MQTT d2/safety/stop/req&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;{source: voice} → 브리지 → 정지 노드(STOP_VOICE)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="8228.0" y="809.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="voice.out2" value="&lt;b&gt;HTTPS → OpenAI 받아 적기&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;WAV → 글 · logprobs(키 = 웹 PC .env OPENAI_API_KEY)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="8228.0" y="876.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="voice.out3" value="&lt;b&gt;스피커 — 삑&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;1320 Hz(시동어 들음) · 660 Hz(녹음 끝)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="8228.0" y="943.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="voice.st0" value="① 듣기 대기 — 마이크 열고 말소리 거르기(Silero VAD ≥ 0.5)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="7852.0" y="710.0" width="330.0" height="40.0" as="geometry"/></mxCell><mxCell id="voice.st1" value="② 시동어 &quot;hello rokey&quot;(openWakeWord · 임계 0.3) — 6초 안에 안 들리면 그만(아무것도 안 보냄 · 화면은 20초 뒤 안내)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="7852.0" y="760.0" width="330.0" height="55.0" as="geometry"/></mxCell><mxCell id="voice.st2" value="③ 삑(높은 음) → 요청 녹음(4초 안 말 시작 · 0.8초 조용하면 끝 · 최대 7초) → 삑(낮은 음)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="7852.0" y="825.0" width="330.0" height="40.0" as="geometry"/></mxCell><mxCell id="voice.st3" value="④ 받아 적기 — OpenAI gpt-4o-mini-transcribe(실패하면 whisper-1 한 번 — 키 · 권한 · 크레딧 오류는 바로 멈춤, 단 모델 권한 없음 403 model_not_found는 넘김 E-120 · 8초 상한) · language ko · 가구 낱말 힌트 · 지어낸 글 거르기 · 확신도 = logprobs 평균(0 ~ 1, whisper-1 · 못 구하면 null)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="7852.0" y="875.0" width="330.0" height="115.0" as="geometry"/></mxCell><mxCell id="voice.st4" value="⑤ 정지 낱말로만 된 글(&#x27;정지&#x27; 대표 · 멈춰 · 스톱 · 그만 — STOP_RE)이면 정지 요청(보조 정지) · 그 밖은 요청 글 → 화면이 글 창에 넣고 바로 생성(출발은 안 함 — E-96)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="7852.0" y="1000.0" width="330.0" height="70.0" as="geometry"/></mxCell><mxCell id="voice.c0" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1f4fd6;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.300;entryDx=0;entryDy=0;" edge="1" parent="1" source="voice.in0" target="voice.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7816.0" y="728.5"/><mxPoint x="7816.0" y="722.0"/></Array></mxGeometry></mxCell><mxCell id="voice.c1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.300;entryDx=0;entryDy=0;" edge="1" parent="1" source="voice.in1" target="voice.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7824.0" y="809.5"/><mxPoint x="7824.0" y="722.0"/></Array></mxGeometry></mxCell><mxCell id="voice.c2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.327;entryDx=0;entryDy=0;" edge="1" parent="1" source="voice.in1" target="voice.st1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7824.0" y="809.5"/><mxPoint x="7824.0" y="778.0"/></Array></mxGeometry></mxCell><mxCell id="voice.c3" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="voice.in1" target="voice.st2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7824.0" y="809.5"/><mxPoint x="7824.0" y="845.0"/></Array></mxGeometry></mxCell><mxCell id="voice.c4" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1f4fd6;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="voice.st4" target="voice.out0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="8192.0" y="1035.0"/><mxPoint x="8192.0" y="742.5"/></Array></mxGeometry></mxCell><mxCell id="voice.c5" style="edgeStyle=none;rounded=0;html=1;strokeColor=#e00000;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="voice.st4" target="voice.out1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="8200.0" y="1035.0"/><mxPoint x="8200.0" y="837.5"/></Array></mxGeometry></mxCell><mxCell id="voice.c6" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="voice.st3" target="voice.out2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="8208.0" y="932.5"/><mxPoint x="8208.0" y="904.5"/></Array></mxGeometry></mxCell><mxCell id="voice.c7" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="voice.st2" target="voice.out3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="8216.0" y="845.0"/><mxPoint x="8216.0" y="971.5"/></Array></mxGeometry></mxCell><mxCell id="voice.c8" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9aa5b1;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=0.073;exitY=1.000;exitDx=0;exitDy=0;entryX=0.073;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="voice.st0" target="voice.st1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="voice.c9" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9aa5b1;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=0.073;exitY=1.000;exitDx=0;exitDy=0;entryX=0.073;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="voice.st1" target="voice.st2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="voice.c10" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9aa5b1;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=0.073;exitY=1.000;exitDx=0;exitDy=0;entryX=0.073;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="voice.st2" target="voice.st3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="voice.c11" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9aa5b1;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=0.073;exitY=1.000;exitDx=0;exitDy=0;entryX=0.073;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="voice.st3" target="voice.st4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mqtt" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7785;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190.0" y="606.0" width="912.0" height="339.0" as="geometry"/></mxCell><mxCell id="mqtt.head" value="&lt;b style=&quot;font-size:16px&quot;&gt;mosquitto — MQTT 브로커 (웹 PC 컨테이너 · 1883)&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fde9d9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=72;" vertex="1" parent="1"><mxGeometry x="190.0" y="606.0" width="912.0" height="50.0" as="geometry"/></mxCell><mxCell id="mqtt.badge" value="&lt;b&gt;노드&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200.0" y="618.0" width="52.0" height="24.0" as="geometry"/></mxCell><mxCell id="mqtt.meta" value="HMI · 패키지 web/mosquitto&lt;br&gt;&lt;b&gt;&lt;span style=&quot;color:#1565c0&quot;&gt;돌리는 곳: 컨테이너 mosquitto&lt;/span&gt;&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="742.0" y="610.0" width="350.0" height="42.0" as="geometry"/></mxCell><mxCell id="mqtt.col10" value="&lt;b&gt;입력 — 받는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="200.0" y="660.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="mqtt.col266" value="&lt;b&gt;처리 — 하는 일(번호 순)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="456.0" y="660.0" width="380.0" height="22.0" as="geometry"/></mxCell><mxCell id="mqtt.col692" value="&lt;b&gt;출력 — 내보내는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="882.0" y="660.0" width="210.0" height="22.0" as="geometry"/></mxCell><mxCell id="mqtt.grp0" value="&lt;b&gt;전달만 — 판단 없음&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="450.0" y="686.0" width="392.0" height="241.0" as="geometry"/></mxCell><mxCell id="mqtt.in0" value="&lt;b&gt;웹 PC가 발행&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;backend · voice.py — 요청 · 응답 · 연결 신호 · 음성&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="200.0" y="686.0" width="210.0" height="57.0" as="geometry"/></mxCell><mxCell id="mqtt.in1" value="&lt;b&gt;로봇 PC가 발행&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;bridge — 상태 · 응답 · 사진 · 점군 · 로봇이 부르는 요청 · 연결 신호&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="200.0" y="753.0" width="210.0" height="71.0" as="geometry"/></mxCell><mxCell id="mqtt.out0" value="&lt;b&gt;구독자에게 → 웹 PC&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;backend · voice.py&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="882.0" y="686.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="mqtt.out1" value="&lt;b&gt;구독자에게 → 로봇 PC&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#0b5fa5&quot;&gt;bridge&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="882.0" y="739.0" width="210.0" height="43.0" as="geometry"/></mxCell><mxCell id="mqtt.st0" value="① 토픽 = d2/&lt;ROS 이름&gt;(규칙 bridge_codec.py) — 토픽별 보내는 쪽 → 받는 쪽은 MQTT 토픽 표" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="456.0" y="710.0" width="380.0" height="40.0" as="geometry"/></mxCell><mxCell id="mqtt.st1" value="② 요청 · 응답 = …/req → …/res + req_id(QoS 1) · 5초 안 응답 없으면 보낸 쪽이 TIMEOUT" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="456.0" y="760.0" width="380.0" height="40.0" as="geometry"/></mxCell><mxCell id="mqtt.st2" value="③ 상태 · 연결 신호 = retained(늦게 붙어도 마지막 값) · 끊기면 LWT alive false / 사진 · 점군 바이트는 retained 아님" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="456.0" y="810.0" width="380.0" height="55.0" as="geometry"/></mxCell><mxCell id="mqtt.st3" value="④ 공개 범위 = 웹 PC Wi-Fi IPv4:1883에만 · DOCKER-USER로 로봇 PC IP만(#136)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="456.0" y="875.0" width="380.0" height="40.0" as="geometry"/></mxCell><mxCell id="mqtt.c0" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.300;entryDx=0;entryDy=0;" edge="1" parent="1" source="mqtt.in0" target="mqtt.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420.0" y="714.5"/><mxPoint x="420.0" y="722.0"/></Array></mxGeometry></mxCell><mxCell id="mqtt.c1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.450;entryDx=0;entryDy=0;" edge="1" parent="1" source="mqtt.in0" target="mqtt.st1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420.0" y="714.5"/><mxPoint x="420.0" y="778.0"/></Array></mxGeometry></mxCell><mxCell id="mqtt.c2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a8a8a8;strokeWidth=1.4;endArrow=blockThin;endFill=1;endSize=5;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.00